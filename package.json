{
  "name": "virai-memorial",
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/postbuild.mjs",
    "preview": "npm run build && wrangler dev",
    "astro": "astro",
    "check": "astro check",
    "test": "node --test scripts/*.test.ts",
    "generate-types": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply virai-memorial --local",
    "db:migrate": "wrangler d1 migrations apply virai-memorial --remote",
    "db:seed:local": "wrangler d1 execute virai-memorial --local --file=./scripts/seed-demo.sql",
    "db:seed": "wrangler d1 execute virai-memorial --remote --file=./scripts/seed-demo.sql",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.5.2",
    "@astrojs/sitemap": "^3.7.2",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^6.3.5",
    "drizzle-orm": "^0.45.2",
    "tailwindcss": "^4.3.0",
    "uqr": "^0.1.3",
    "workers-og": "^0.0.27"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "drizzle-kit": "^0.31.10",
    "typescript": "^6.0.3",
    "wrangler": "^4.92.0"
  },
  "overrides": {
    "vite": "^7"
  }
}
