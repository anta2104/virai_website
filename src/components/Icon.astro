---
import { ICON_PATHS, type IconName } from '../lib/icons';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  /** Nét đậm hơn cho icon cỡ nhỏ */
  weight?: number;
}

const { name, size = 24, class: className = '', weight = 1.5 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={weight}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
  focusable="false"
  set:html={ICON_PATHS[name]}
/>
