---
import { contact as defaultContact, ui as defaultUi } from '../data/site';

const { contact = defaultContact, ui = defaultUi } = Astro.props;
---

<section id="contact" class="section-padding bg-slate-900/50">
  <div class="mx-auto max-w-7xl">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <p class="text-sm font-semibold uppercase tracking-widest text-virai-400">{ui.contactEyebrow}</p>
        <h2 class="mt-3 text-3xl font-bold text-white sm:text-4xl">
          {ui.contactTitle}
        </h2>
        <p class="mt-4 text-slate-400 leading-relaxed">
          {ui.contactDescription}
        </p>

        <ul class="mt-10 space-y-6">
          <li class="flex items-start gap-4">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-virai-600/20">
              <svg class="h-5 w-5 text-virai-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
              </svg>
            </div>
            <div>
              <p class="text-sm font-medium text-slate-400">Email</p>
              <a href={`mailto:${contact.email}`} class="text-white hover:text-virai-300 transition-colors">
                {contact.email}
              </a>
            </div>
          </li>
          <li class="flex items-start gap-4">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-virai-600/20">
              <svg class="h-5 w-5 text-virai-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.47.704a21.373 21.373 0 01-5.085-2.885 21.373 21.373 0 01-2.885-5.085l.704-.47c.362-.271.527-.733.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
              </svg>
            </div>
            <div>
              <p class="text-sm font-medium text-slate-400">{ui.phoneLabel}</p>
              <a href={`tel:${contact.phone.replace(/\s/g, '')}`} class="text-white hover:text-virai-300 transition-colors">
                {contact.phone}
              </a>
            </div>
          </li>
          <li class="flex items-start gap-4">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-virai-600/20">
              <svg class="h-5 w-5 text-virai-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
              </svg>
            </div>
            <div>
              <p class="text-sm font-medium text-slate-400">{ui.addressLabel}</p>
              <p class="text-white">{contact.address}</p>
            </div>
          </li>
        </ul>
      </div>

      <form
        id="contact-form"
        action={contact.formEndpoint}
        method="POST"
        class="glass rounded-2xl p-6 sm:p-8"
        novalidate
      >
        <div id="form-success" class="hidden mb-6 rounded-lg bg-green-500/10 border border-green-500/30 px-4 py-3 text-sm text-green-400">
          {ui.formSuccess}
        </div>
        <div id="form-error" class="hidden mb-6 rounded-lg bg-red-500/10 border border-red-500/30 px-4 py-3 text-sm text-red-400">
          {ui.formError}
        </div>

        {
          !contact.formReady && (
            <div class="mb-6 rounded-lg border border-amber-500/30 bg-amber-500/10 px-4 py-3 text-sm text-amber-200">
              {ui.formPending}
            </div>
          )
        }

        <div class="space-y-5">
          <div>
            <label for="name" class="mb-1.5 block text-sm font-medium text-slate-300">
              {ui.nameLabel} <span class="text-red-400">*</span>
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              minlength="2"
              autocomplete="name"
              class="w-full rounded-lg border border-white/10 bg-slate-900/80 px-4 py-2.5 text-white placeholder-slate-500 outline-none transition-colors focus:border-virai-500 focus:ring-1 focus:ring-virai-500"
              placeholder={ui.namePlaceholder}
            />
            <p class="mt-1 hidden text-xs text-red-400" data-error="name"></p>
          </div>

          <div>
            <label for="email" class="mb-1.5 block text-sm font-medium text-slate-300">
              Email <span class="text-red-400">*</span>
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              autocomplete="email"
              class="w-full rounded-lg border border-white/10 bg-slate-900/80 px-4 py-2.5 text-white placeholder-slate-500 outline-none transition-colors focus:border-virai-500 focus:ring-1 focus:ring-virai-500"
              placeholder={ui.emailPlaceholder}
            />
            <p class="mt-1 hidden text-xs text-red-400" data-error="email"></p>
          </div>

          <div>
            <label for="phone" class="mb-1.5 block text-sm font-medium text-slate-300">
              {ui.phoneLabel}
            </label>
            <input
              type="tel"
              id="phone"
              name="phone"
              autocomplete="tel"
              class="w-full rounded-lg border border-white/10 bg-slate-900/80 px-4 py-2.5 text-white placeholder-slate-500 outline-none transition-colors focus:border-virai-500 focus:ring-1 focus:ring-virai-500"
              placeholder={ui.phonePlaceholder}
            />
            <p class="mt-1 hidden text-xs text-red-400" data-error="phone"></p>
          </div>

          <div>
            <label for="solution" class="mb-1.5 block text-sm font-medium text-slate-300">
              {ui.solutionLabel}
            </label>
            <select
              id="solution"
              name="solution"
              class="w-full rounded-lg border border-white/10 bg-slate-900/80 px-4 py-2.5 text-white outline-none transition-colors focus:border-virai-500 focus:ring-1 focus:ring-virai-500"
            >
              <option value="">{ui.solutionPlaceholder}</option>
              {ui.solutionOptions.map((option) => <option value={option.value}>{option.label}</option>)}
            </select>
          </div>

          <div>
            <label for="message" class="mb-1.5 block text-sm font-medium text-slate-300">
              {ui.messageLabel} <span class="text-red-400">*</span>
            </label>
            <textarea
              id="message"
              name="message"
              required
              minlength="10"
              rows="4"
              class="w-full resize-none rounded-lg border border-white/10 bg-slate-900/80 px-4 py-2.5 text-white placeholder-slate-500 outline-none transition-colors focus:border-virai-500 focus:ring-1 focus:ring-virai-500"
              placeholder={ui.messagePlaceholder}
            ></textarea>
            <p class="mt-1 hidden text-xs text-red-400" data-error="message"></p>
          </div>

          <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" />

          <button
            type="submit"
            id="submit-btn"
            class="w-full rounded-xl bg-virai-600 px-6 py-3.5 text-sm font-semibold text-white transition-all hover:bg-virai-500 disabled:cursor-not-allowed disabled:opacity-60"
          >
            {ui.submitLabel}
          </button>

          <a
            href={`mailto:${contact.email}?subject=${encodeURIComponent(ui.emailSubject)}`}
            class="flex w-full items-center justify-center gap-2 rounded-xl border border-white/15 bg-white/5 px-6 py-3.5 text-sm font-semibold text-white transition-all hover:bg-white/10"
          >
            {ui.directEmailLabel}
          </a>
        </div>
      </form>
    </div>
  </div>
</section>

<script
  define:vars={{
    formEndpoint: contact.formEndpoint,
    contactEmail: contact.email,
    formLabels: {
      validationName: ui.validationName,
      validationEmail: ui.validationEmail,
      validationPhone: ui.validationPhone,
      validationMessage: ui.validationMessage,
      fallbackEmailSubject: ui.fallbackEmailSubject,
      submitFailure: ui.submitFailure,
      submitLabel: ui.submitLabel,
      submittingLabel: ui.submittingLabel,
      nameLabel: ui.nameLabel,
      phoneLabel: ui.phoneLabel,
      solutionLabel: ui.solutionLabel,
    },
  }}
>
  const form = document.getElementById('contact-form');
  const submitBtn = document.getElementById('submit-btn');
  const successEl = document.getElementById('form-success');
  const errorEl = document.getElementById('form-error');

  const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  const phoneRegex = /^(0|\+84)[0-9]{8,12}$/;

  function showFieldError(fieldId, message) {
    const input = document.getElementById(fieldId);
    const err = document.querySelector(`[data-error="${fieldId}"]`);
    if (input) input.classList.add('border-red-500');
    if (err) {
      err.textContent = message;
      err.classList.remove('hidden');
    }
  }

  function clearErrors() {
    form?.querySelectorAll('[data-error]').forEach((el) => {
      el.classList.add('hidden');
      el.textContent = '';
    });
    form?.querySelectorAll('input, textarea').forEach((el) => {
      el.classList.remove('border-red-500');
    });
    errorEl?.classList.add('hidden');
  }

  function validate() {
    clearErrors();
    let valid = true;

    const name = document.getElementById('name')?.value.trim() ?? '';
    const email = document.getElementById('email')?.value.trim() ?? '';
    const phone = document.getElementById('phone')?.value.trim() ?? '';
    const message = document.getElementById('message')?.value.trim() ?? '';

    if (name.length < 2) {
      showFieldError('name', formLabels.validationName);
      valid = false;
    }
    if (!emailRegex.test(email)) {
      showFieldError('email', formLabels.validationEmail);
      valid = false;
    }
    if (phone && !phoneRegex.test(phone.replace(/[\s.-]/g, ''))) {
      showFieldError('phone', formLabels.validationPhone);
      valid = false;
    }
    if (message.length < 10) {
      showFieldError('message', formLabels.validationMessage);
      valid = false;
    }

    return valid;
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!validate()) return;

    if (!formEndpoint) {
      const name = document.getElementById('name')?.value.trim() ?? '';
      const email = document.getElementById('email')?.value.trim() ?? '';
      const phone = document.getElementById('phone')?.value.trim() ?? '';
      const solution = document.getElementById('solution')?.value ?? '';
      const message = document.getElementById('message')?.value.trim() ?? '';
      const body = [
        `${formLabels.nameLabel}: ${name}`,
        `Email: ${email}`,
        phone ? `${formLabels.phoneLabel}: ${phone}` : '',
        solution ? `${formLabels.solutionLabel}: ${solution}` : '',
        '',
        message,
      ]
        .filter(Boolean)
        .join('\n');
      window.location.href = `mailto:${contactEmail}?subject=${encodeURIComponent(formLabels.fallbackEmailSubject)}&body=${encodeURIComponent(body)}`;
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = formLabels.submittingLabel;

    try {
      const res = await fetch(formEndpoint, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });

      if (res.ok) {
        form.reset();
        successEl?.classList.remove('hidden');
        errorEl?.classList.add('hidden');
      } else {
        throw new Error('Submit failed');
      }
    } catch {
      errorEl?.classList.remove('hidden');
      if (errorEl) {
        errorEl.textContent = formLabels.submitFailure;
      }
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = formLabels.submitLabel;
    }
  });
</script>
