---
import Icon from './Icon.astro';

interface Props {
  /** Bước hiện tại, tính từ 1 */
  current: number;
  /** id của trang kỷ niệm — có rồi thì các bước sau bấm được */
  memorialId?: string | null;
}

const { current, memorialId = null } = Astro.props;

const steps = [
  { label: 'Về bé', href: memorialId ? `/tai-khoan/be/${memorialId}/thong-tin` : '/tai-khoan/tao-trang' },
  { label: 'Ảnh', href: memorialId ? `/tai-khoan/be/${memorialId}/anh` : null },
  { label: 'Câu chuyện', href: memorialId ? `/tai-khoan/be/${memorialId}/cau-chuyen` : null },
  { label: 'Giao diện', href: memorialId ? `/tai-khoan/be/${memorialId}/giao-dien` : null },
  { label: 'Xuất bản', href: memorialId ? `/tai-khoan/be/${memorialId}/xem-truoc` : null },
];
---

<nav class="mb-10" aria-label="Các bước tạo trang">
  <ol class="flex items-start">
    {
      steps.map((step, index) => {
        const number = index + 1;
        const state = number === current ? 'current' : number < current ? 'done' : 'todo';
        const isLast = index === steps.length - 1;

        const marker = (
          <span
            class:list={[
              'flex h-7 w-7 items-center justify-center rounded-full border text-xs font-semibold transition',
              state === 'current' && 'border-clay-500 bg-clay-500 text-white',
              state === 'done' && 'border-sage-300 bg-sage-100 text-sage-700',
              state === 'todo' && 'border-cream-300 bg-cream-100 text-ink-500',
            ]}
          >
            {state === 'done' ? <Icon name="check" size={13} weight={2.2} /> : number}
          </span>
        );

        const label = (
          <span
            class:list={[
              'mt-2 block text-xs sm:text-[0.8125rem]',
              state === 'current' ? 'font-semibold text-ink-900' : 'text-ink-500',
            ]}
          >
            {step.label}
          </span>
        );

        return (
          <li class:list={['flex flex-1 flex-col items-center', isLast && 'flex-none']}>
            <span class="flex w-full items-center">
              {/* Đường nối bên trái, ẩn ở bước đầu */}
              <span
                class:list={[
                  'h-px flex-1',
                  index === 0 ? 'invisible' : number <= current ? 'bg-clay-300' : 'bg-cream-300',
                ]}
              />
              {step.href && state !== 'current' ? (
                <a href={step.href} class="shrink-0" aria-label={`Tới bước ${step.label}`}>
                  {marker}
                </a>
              ) : (
                <span class="shrink-0" aria-current={state === 'current' ? 'step' : undefined}>
                  {marker}
                </span>
              )}
              {/* Đường nối bên phải, ẩn ở bước cuối */}
              <span
                class:list={[
                  'h-px flex-1',
                  isLast ? 'invisible' : number < current ? 'bg-clay-300' : 'bg-cream-300',
                ]}
              />
            </span>

            {step.href && state !== 'current' ? (
              <a href={step.href} class="transition hover:text-clay-700">
                {label}
              </a>
            ) : (
              label
            )}
          </li>
        );
      })
    }
  </ol>
</nav>
