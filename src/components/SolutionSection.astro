---
import type { Solution } from '../data/site';

interface Props {
  solution: Solution;
}

const { solution } = Astro.props;
---

<article
  id={solution.id}
  class:list={['section-padding', solution.reverse && 'bg-slate-900/50']}
>
  <div class="mx-auto max-w-7xl">
    <div
      class:list={[
        'grid items-center gap-12 lg:grid-cols-2 lg:gap-16',
        solution.reverse && 'lg:[&>*:first-child]:order-2',
      ]}
    >
      <div>
        <p class="text-sm font-bold text-virai-400">Giải pháp {solution.number}</p>
        <p class="mt-1 text-sm font-medium text-cyan-400">{solution.subtitle}</p>
        {
          solution.productLead && (
            <p class="mt-2 text-sm text-slate-500">
              Product Lead: <span class="font-medium text-slate-300">{solution.productLead}</span>
            </p>
          )
        }
        <h2 class="mt-4 text-2xl font-bold leading-snug text-white sm:text-3xl">
          {solution.title}
        </h2>
        <p class="mt-4 text-slate-400 leading-relaxed">{solution.description}</p>

        <ul class="mt-8 space-y-3">
          {
            solution.features.map((feature) => (
              <li class="flex items-start gap-3 text-sm text-slate-300">
                <svg
                  class="mt-0.5 h-5 w-5 shrink-0 text-virai-400"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                  />
                </svg>
                {feature}
              </li>
            ))
          }
        </ul>

        <a
          href="#contact"
          class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-virai-400 transition-colors hover:text-virai-300"
        >
          Tư vấn giải pháp này
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>

      <div class="grid grid-cols-2 gap-3 sm:gap-4">
        {
          solution.images.map((img, i) => {
            const isSvg = img.src.endsWith('.svg');
            return (
              <div
                class:list={[
                  'group overflow-hidden rounded-xl border border-white/10 bg-slate-900',
                  i === 0 && 'col-span-2',
                  isSvg && 'flex min-h-[200px] items-center justify-center p-2 sm:min-h-[240px]',
                ]}
              >
                <img
                  src={img.src}
                  alt={img.alt}
                  class:list={[
                    'w-full transition-transform duration-500 group-hover:scale-[1.02]',
                    isSvg ? 'h-auto max-h-[320px] object-contain' : 'h-full min-h-[160px] object-cover',
                  ]}
                  loading="lazy"
                  width={i === 0 ? 800 : 400}
                  height={i === 0 ? 450 : 300}
                />
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
</article>
