---
import { navLinks } from '../data/site';
---

<header
  id="header"
  class="fixed inset-x-0 top-0 z-50 border-b border-white/5 bg-slate-950/80 backdrop-blur-xl transition-shadow"
>
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
    <a href="#" class="flex items-center gap-2" aria-label="Virai — Trang chủ">
      <img src="/logo.svg" alt="Virai" class="h-9 w-auto" width="140" height="36" />
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label="Điều hướng chính">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="text-sm font-medium text-slate-300 transition-colors hover:text-white"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="#contact"
        class="rounded-lg bg-virai-600 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-virai-500"
      >
        Liên hệ tư vấn
      </a>
    </nav>

    <button
      id="menu-toggle"
      type="button"
      class="flex h-10 w-10 items-center justify-center rounded-lg border border-white/10 text-slate-300 md:hidden"
      aria-label="Mở menu"
      aria-expanded="false"
    >
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path id="menu-icon-open" stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16" />
        <path
          id="menu-icon-close"
          class="hidden"
          stroke-linecap="round"
          d="M6 18L18 6M6 6l12 12"
        />
      </svg>
    </button>
  </div>

  <div
    id="mobile-menu"
    class="hidden border-t border-white/5 bg-slate-950/95 px-4 py-4 md:hidden"
  >
    <nav class="flex flex-col gap-3" aria-label="Menu di động">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="rounded-lg px-3 py-2 text-sm font-medium text-slate-300 hover:bg-white/5 hover:text-white"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="#contact"
        class="mt-2 rounded-lg bg-virai-600 px-4 py-2.5 text-center text-sm font-semibold text-white"
      >
        Liên hệ tư vấn
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(isOpen));
    iconOpen?.classList.toggle('hidden', isOpen);
    iconClose?.classList.toggle('hidden', !isOpen);
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    });
  });
</script>
