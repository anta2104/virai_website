---
import { PRICES, formatVnd, type PriceKey } from '../lib/plans';
import PriceTag from './PriceTag.astro';
import Icon from './Icon.astro';

interface Props {
  /** Đích của nút CTA — khác nhau giữa landing và trang bảng giá */
  ctaHref?: string;
}

const { ctaHref = '/dang-ky' } = Astro.props;

interface Feature {
  text: string;
  /** Dòng nhỏ giải thích vì sao quyền lợi này đáng tiền */
  note?: string;
}

const plans: Array<{
  name: string;
  plan: PriceKey | null;
  price: string;
  note: string;
  highlight: boolean;
  features: Feature[];
  limits: string[];
  cta: string;
}> = [
  {
    name: 'Miễn phí',
    plan: null,
    price: '0đ',
    note: 'Dùng mãi mãi',
    highlight: false,
    features: [
      { text: '1 trang kỷ niệm' },
      { text: 'Tối đa 10 ảnh' },
      { text: 'Theme “Ấm áp”' },
      { text: 'AI viết giúp tiểu sử (3 lần/ngày)' },
      { text: 'Mã QR chia sẻ' },
      { text: 'Sổ lưu bút (hiển thị 20 lời gần nhất)' },
    ],
    limits: ['Có dòng “Tạo bởi Virai Memorial” ở cuối trang', 'Không có email nhắc ngày tưởng niệm'],
    cta: 'Tạo trang miễn phí',
  },
  {
    name: 'Premium',
    plan: 'premium',
    price: '',
    note: 'Trả một lần cho mỗi bé — không phí tháng, không phí năm',
    highlight: true,
    features: [
      {
        text: 'Email nhắc cúng 49 ngày, 100 ngày và giỗ hằng năm',
        note: 'Tự tính theo âm lịch, nhắc trước 3 ngày — thứ dễ quên nhất vì âm lịch lệch mỗi năm',
      },
      {
        text: 'Tối đa 200 ảnh cho mỗi bé',
        note: 'Gấp 20 lần gói miễn phí — đủ cho cả một đời kỷ niệm',
      },
      {
        text: 'Đủ 3 giao diện: Ấm áp, Thanh tịnh, Đêm sao',
      },
      {
        text: 'Sổ lưu bút không giới hạn',
        note: 'Gói miễn phí chỉ hiện 20 lời gần nhất',
      },
      {
        text: 'Không còn dòng thương hiệu ở cuối trang',
        note: 'Trang hoàn toàn là của gia đình bạn',
      },
      {
        text: 'Tải mã QR sắc nét để tự in hoặc khắc',
      },
      {
        text: 'AI viết giúp 30 lần/ngày',
      },
    ],
    limits: [],
    cta: 'Nâng cấp Premium',
  },
  {
    name: 'Combo thẻ QR',
    plan: 'physicalCombo',
    price: '',
    note: 'Premium + thẻ khắc QR gửi tận nhà',
    highlight: false,
    features: [
      { text: 'Toàn bộ quyền lợi Premium' },
      { text: 'Thẻ kim loại hoặc gỗ khắc mã QR của bé' },
      { text: 'Khắc tên và ngày tháng lên thẻ' },
      { text: 'Giao hàng toàn quốc' },
    ],
    limits: [],
    cta: 'Đặt combo',
  },
];
---

<div class="grid gap-6 lg:grid-cols-3">
  {
    plans.map((plan) => (
      <div
        class:list={[
          'card flex flex-col p-6',
          plan.highlight && 'border-clay-300 bg-white ring-2 ring-clay-200',
        ]}
      >
        {plan.highlight && (
          <span class="badge mb-3 self-start bg-clay-100 text-clay-700">Phổ biến nhất</span>
        )}
        <h3 class="font-serif text-xl font-semibold">{plan.name}</h3>
        {
          plan.plan ? (
            <PriceTag plan={plan.plan} from={plan.plan === 'physicalCombo'} class="mt-3" />
          ) : (
            <p class="mt-3 text-3xl font-semibold text-ink-900">{plan.price}</p>
          )
        }
        <p class="mt-2 text-sm text-ink-500">{plan.note}</p>

        <ul class="mt-5 flex-1 space-y-2.5 text-sm">
          {plan.features.map((feature) => (
            <li class="flex gap-2.5">
              <span class="mt-1 shrink-0 text-clay-500">
                <Icon name="check" size={15} weight={2} />
              </span>
              <span>
                {feature.text}
                {feature.note && (
                  <span class="mt-0.5 block text-xs leading-relaxed text-ink-500">
                    {feature.note}
                  </span>
                )}
              </span>
            </li>
          ))}
          {plan.limits.map((limit) => (
            <li class="flex gap-2.5 text-ink-500">
              <span class="mt-0.5" aria-hidden="true">–</span>
              <span>{limit}</span>
            </li>
          ))}
        </ul>

        <a
          href={ctaHref}
          class:list={['mt-6 w-full', plan.highlight ? 'btn-primary' : 'btn-secondary']}
        >
          {plan.cta}
        </a>
      </div>
    ))
  }
</div>
