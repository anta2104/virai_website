---
import type { GuestbookEntry, Memorial, Photo } from '../lib/db/schema';
import CandleIcon from './CandleIcon.astro';
import { photoUrl } from '../lib/memorials';
import { lifeSummary, milestonesFor } from '../lib/memorial-dates';
import { GENDER_LABEL, SPECIES_LABEL, formatDate, formatDateTime } from '../lib/format';
import { site } from '../lib/site';

interface Props {
  memorial: Memorial;
  photos: Photo[];
  entries: GuestbookEntry[];
  /** Hiện dòng "Tạo bởi..." (gói miễn phí) */
  showBranding: boolean;
  /** Chế độ xem trước trong khu quản lý: tắt tương tác, không đếm lượt */
  preview?: boolean;
  /** Thông báo sau khi gửi lưu bút */
  guestbookNotice?: string | null;
  guestbookError?: string | null;
  /** Còn bao nhiêu lời lưu bút bị ẩn vì hạn mức gói miễn phí */
  hiddenEntries?: number;
  /** Khách này hôm nay đã thắp nến / thả hoa chưa (đọc từ cookie phía server) */
  litCandle?: boolean;
  gaveFlower?: boolean;
}

const {
  memorial,
  photos,
  entries,
  showBranding,
  preview = false,
  guestbookNotice = null,
  guestbookError = null,
  hiddenEntries = 0,
  litCandle = false,
  gaveFlower = false,
} = Astro.props;

const cover = photos.find((photo) => photo.id === memorial.coverPhotoId) ?? photos[0] ?? null;
const gallery = photos.filter((photo) => photo.id !== cover?.id);
const summary = lifeSummary(memorial.birthDate, memorial.deathDate);
const milestones = milestonesFor(memorial.deathDate);
const speciesLine = [SPECIES_LABEL[memorial.species], memorial.breed, GENDER_LABEL[memorial.gender]]
  .filter(Boolean)
  .join(' · ');

/** Số nến vẽ ra trên dãy — nhiều hơn thì gộp vào dòng "và N người khác". */
const WALL_LIMIT = 24;
const wallCandles = Math.min(memorial.candleCount, WALL_LIMIT);
const extraCandles = Math.max(0, memorial.candleCount - WALL_LIMIT);
---

<div data-memorial-theme={memorial.theme} class="memorial-surface min-h-screen overflow-x-clip">
  <div class="memorial-stars">
    <!-- Ảnh bìa + tên -->
    <section class="relative">
      {
        cover ? (
          <div class="relative h-[52vh] max-h-[620px] min-h-72 w-full overflow-hidden sm:h-[62vh]">
            <img
              src={photoUrl(cover.r2Key)}
              alt={`Ảnh của ${memorial.petName}`}
              class="h-full w-full object-cover"
            />
            <div
              class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"
              aria-hidden="true"
            />
            <div class="absolute inset-x-0 bottom-0 p-6 text-center sm:p-10">
              <p class="text-xs font-medium tracking-[0.2em] text-white/80 uppercase">Tưởng nhớ</p>
              <h1 class="mt-2 font-serif text-4xl font-semibold text-white drop-shadow sm:text-5xl">
                {memorial.petName}
              </h1>
              {summary.dateLine && (
                <p class="mt-3 text-white/90">{summary.dateLine}</p>
              )}
            </div>
          </div>
        ) : (
          <div class="px-6 pt-16 pb-8 text-center">
            <p class="memorial-muted text-xs font-medium tracking-[0.2em] uppercase">Tưởng nhớ</p>
            <h1 class="memorial-heading mt-3 font-serif text-4xl font-semibold sm:text-5xl">
              {memorial.petName}
            </h1>
            {summary.dateLine && <p class="memorial-muted mt-3">{summary.dateLine}</p>}
          </div>
        )
      }
    </section>

    <div class="mx-auto w-full max-w-3xl px-4 pb-20 sm:px-6">
      <!-- Thông tin nhanh -->
      <div class="memorial-panel mt-8 rounded-2xl border p-5 text-center sm:p-6">
        {speciesLine && <p class="memorial-muted text-sm">{speciesLine}</p>}
        {summary.spanLine && (
          <p class="memorial-heading mt-1 font-serif text-lg">{summary.spanLine}</p>
        )}
        {summary.lunarLine && <p class="memorial-muted mt-2 text-sm">{summary.lunarLine}</p>}

        <p class="memorial-muted mt-5 text-xs sm:text-sm">
          {memorial.visitCount.toLocaleString('vi-VN')} lượt ghé thăm
        </p>
      </div>

      <!-- Nến của mọi người + nút gửi -->
      <section class="mt-10" data-tributes data-slug={memorial.slug} data-wall-limit={WALL_LIMIT}>
        <div class="vm-candle-wall" data-candle-wall>
          {
            Array.from({ length: wallCandles }).map((_, index) => (
              <CandleIcon lit delay={(index % 7) * 0.21} size="sm" />
            ))
          }
        </div>

        <p class="memorial-muted mt-4 text-center text-sm" data-tribute-summary>
          {
            memorial.candleCount === 0 && memorial.flowerCount === 0
              ? `Chưa có ai thắp nến cho ${memorial.petName}. Bạn là người đầu tiên.`
              : [
                  memorial.candleCount > 0
                    ? `${memorial.candleCount.toLocaleString('vi-VN')} ngọn nến đã được thắp`
                    : null,
                  memorial.flowerCount > 0
                    ? `${memorial.flowerCount.toLocaleString('vi-VN')} cánh hoa đã thả`
                    : null,
                ]
                  .filter(Boolean)
                  .join(' · ')
          }
          {extraCandles > 0 && <span class="block text-xs">(hiện {WALL_LIMIT} ngọn gần nhất)</span>}
        </p>

        <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
          <button
            type="button"
            class="memorial-panel flex items-center gap-2.5 rounded-full border px-5 py-2.5 text-sm font-medium transition hover:shadow-md disabled:cursor-default disabled:opacity-100"
            data-tribute="candle"
            data-label-done="Bạn đã thắp nến hôm nay"
            disabled={preview || litCandle}
          >
            <CandleIcon lit={litCandle} size="sm" class="-my-1" />
            <span data-tribute-label>{litCandle ? 'Bạn đã thắp nến hôm nay' : 'Thắp một ngọn nến'}</span>
          </button>

          <button
            type="button"
            class="memorial-panel flex items-center gap-2.5 rounded-full border px-5 py-2.5 text-sm font-medium transition hover:shadow-md disabled:cursor-default disabled:opacity-100"
            data-tribute="flower"
            data-label-done="Bạn đã thả hoa hôm nay"
            disabled={preview || gaveFlower}
          >
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <path
                d="M12 2c4.2 4.4 6 8.4 6 12 0 5.2-2.7 8-6 8s-6-2.8-6-8c0-3.6 1.8-7.6 6-12Z"
                fill="#f0a8bb"
              />
              <path d="M12 7.5c2.3 2.9 3.2 5.3 3.2 7.6 0 3-1.4 4.7-3.2 4.7s-3.2-1.7-3.2-4.7c0-2.3.9-4.7 3.2-7.6Z" fill="#f8ccd8" />
            </svg>
            <span data-tribute-label>{gaveFlower ? 'Bạn đã thả hoa hôm nay' : 'Thả một cánh hoa'}</span>
          </button>

          <button
            type="button"
            class="memorial-panel hidden items-center gap-2 rounded-full border px-5 py-2.5 text-sm font-medium transition hover:shadow-md sm:flex"
            data-share
          >
            <span aria-hidden="true">🔗</span> Chia sẻ
          </button>
        </div>

        <p
          class="memorial-muted mt-3 min-h-5 text-center text-xs"
          data-tribute-status
          role="status"
          aria-live="polite"
        >
          {preview ? 'Đang xem trước — các nút tạm khoá.' : ''}
        </p>
      </section>

      <!-- Câu chuyện -->
      {
        memorial.bio && (
          <section class="mt-14">
            <h2 class="memorial-heading font-serif text-2xl font-semibold">
              Câu chuyện của {memorial.petName}
            </h2>
            <div class="prose-story mt-5">{memorial.bio}</div>
          </section>
        )
      }

      <!-- Các mốc tưởng niệm -->
      {
        milestones.length > 0 && (
          <section class="mt-14">
            <h2 class="memorial-heading font-serif text-2xl font-semibold">Các mốc tưởng niệm</h2>
            <ul class="mt-5 space-y-3">
              {memorial.birthDate && (
                <li class="memorial-panel flex items-start gap-4 rounded-xl border p-4">
                  <span class="text-xl" aria-hidden="true">🌱</span>
                  <div>
                    <p class="memorial-heading font-medium">Ngày bé đến với thế giới</p>
                    <p class="memorial-muted text-sm">{formatDate(memorial.birthDate)}</p>
                  </div>
                </li>
              )}
              {memorial.deathDate && (
                <li class="memorial-panel flex items-start gap-4 rounded-xl border p-4">
                  <span class="text-xl" aria-hidden="true">🤍</span>
                  <div>
                    <p class="memorial-heading font-medium">Ngày bé rời đi</p>
                    <p class="memorial-muted text-sm">
                      {formatDate(memorial.deathDate)}
                      {memorial.deathDateLunar && ` · ${memorial.deathDateLunar}`}
                    </p>
                  </div>
                </li>
              )}
              {milestones.map((milestone) => (
                <li
                  class:list={[
                    'memorial-panel flex items-start gap-4 rounded-xl border p-4',
                    milestone.passed && 'opacity-60',
                  ]}
                >
                  <span class="text-xl" aria-hidden="true">
                    {milestone.key === 'gio_hang_nam' ? '🕰️' : '🪷'}
                  </span>
                  <div>
                    <p class="memorial-heading font-medium">{milestone.label}</p>
                    <p class="memorial-muted text-sm">
                      {formatDate(milestone.date)}
                      {milestone.lunarText && ` · ${milestone.lunarText}`}
                      {milestone.passed && ' · đã qua'}
                    </p>
                    {milestone.note && <p class="memorial-muted mt-1 text-xs">{milestone.note}</p>}
                  </div>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <!-- Album ảnh -->
      {
        gallery.length > 0 && (
          <section class="mt-14">
            <h2 class="memorial-heading font-serif text-2xl font-semibold">Album của bé</h2>
            <div class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-3">
              {gallery.map((item, index) =>
                item.contentType.startsWith('video/') ? (
                  <video
                    src={photoUrl(item.r2Key)}
                    class="aspect-square w-full rounded-xl object-cover"
                    controls
                    preload="metadata"
                  />
                ) : (
                  <button
                    type="button"
                    class="aspect-square overflow-hidden rounded-xl"
                    data-lightbox-open={index}
                    aria-label={`Mở ảnh ${index + 1}`}
                  >
                    <img
                      src={photoUrl(item.r2Key)}
                      alt={item.caption ?? `Ảnh ${index + 1} của ${memorial.petName}`}
                      class="h-full w-full object-cover transition duration-500 hover:scale-105"
                      loading="lazy"
                    />
                  </button>
                ),
              )}
            </div>
          </section>
        )
      }

      <!-- Sổ lưu bút -->
      <section class="mt-14" id="luu-but">
        <h2 class="memorial-heading font-serif text-2xl font-semibold">Sổ lưu bút</h2>
        <p class="memorial-muted mt-2 text-sm">
          Bạn có thể để lại một lời nhắn. Lời nhắn sẽ hiện lên sau khi gia đình duyệt.
        </p>

        {guestbookNotice && <p class="alert-success mt-4">{guestbookNotice}</p>}
        {guestbookError && <p class="alert-error mt-4">{guestbookError}</p>}

        <form method="POST" action={`/be/${memorial.slug}#luu-but`} class="memorial-panel mt-5 space-y-4 rounded-2xl border p-5">
          <input type="hidden" name="action" value="guestbook" />
          <div>
            <label class="label memorial-heading" for="authorName">Tên bạn</label>
            <input
              class="input"
              id="authorName"
              name="authorName"
              required
              maxlength="60"
              disabled={preview}
            />
          </div>
          <div>
            <label class="label memorial-heading" for="message">Lời nhắn</label>
            <textarea
              class="input min-h-28"
              id="message"
              name="message"
              required
              maxlength="1500"
              rows="4"
              placeholder="Một câu ngắn cũng được…"
              disabled={preview}
            />
          </div>
          <button type="submit" class="btn-primary" disabled={preview}>Gửi lời nhắn</button>
          {preview && <p class="memorial-muted text-xs">Đang xem trước — form tạm khoá.</p>}
        </form>

        {
          entries.length > 0 && (
            <ul class="mt-6 space-y-4">
              {entries.map((entry) => (
                <li class="memorial-panel rounded-xl border p-4">
                  <p class="prose-story text-[0.9375rem]">{entry.message}</p>
                  <p class="memorial-muted mt-2 text-xs">
                    {entry.authorName} · {formatDateTime(entry.createdAt)}
                  </p>
                </li>
              ))}
            </ul>
          )
        }

        {
          hiddenEntries > 0 && (
            <p class="memorial-muted mt-4 text-center text-xs">
              Còn {hiddenEntries} lời nhắn nữa chưa hiện (gói miễn phí hiển thị {entries.length} lời
              gần nhất).
            </p>
          )
        }
      </section>

      <!-- Chân trang -->
      {
        showBranding && (
          <p class="memorial-muted mt-16 text-center text-xs">
            Trang kỷ niệm này được tạo bằng{' '}
            <a class="memorial-accent font-medium hover:underline" href={site.url}>
              {site.name}
            </a>
          </p>
        )
      }
    </div>
  </div>

  <!-- Lightbox ảnh -->
  <dialog
    class="fixed inset-0 z-70 h-full max-h-none w-full max-w-none bg-black/90 backdrop:bg-black/80"
    data-lightbox
  >
    <button
      type="button"
      class="absolute top-4 right-4 z-10 rounded-full bg-white/15 px-4 py-2 text-white"
      data-lightbox-close>Đóng ✕</button
    >
    <div class="flex h-full items-center justify-center p-4">
      <figure class="max-h-full">
        <img src="" alt="" class="mx-auto max-h-[80vh] w-auto rounded-lg" data-lightbox-image />
        <figcaption class="mt-3 text-center text-sm text-white/80" data-lightbox-caption></figcaption>
      </figure>
    </div>
  </dialog>
</div>

<script>
  // ── Thắp nến / thả hoa ───────────────────────────────────────────────────
  const tributes = document.querySelector<HTMLElement>('[data-tributes]');
  if (tributes) {
    const slug = tributes.dataset.slug!;
    const wallLimit = Number(tributes.dataset.wallLimit ?? 24);
    const wall = tributes.querySelector<HTMLElement>('[data-candle-wall]');
    const summary = tributes.querySelector<HTMLElement>('[data-tribute-summary]');
    const status = tributes.querySelector<HTMLElement>('[data-tribute-status]');

    const PETAL_COLORS = [
      ['#f0a8bb', '#f8ccd8'],
      ['#eec3a0', '#f8e0c8'],
      ['#e9a7ae', '#f6cdd1'],
      ['#f2d6a8', '#fbecd2'],
    ];

    /** Thả một cơn mưa cánh hoa SVG, mỗi cánh có hướng bay và nhịp lắc riêng. */
    function rainPetals(count = 26) {
      for (let i = 0; i < count; i++) {
        const [outer, inner] = PETAL_COLORS[i % PETAL_COLORS.length]!;
        const petal = document.createElement('span');
        petal.className = 'vm-petal';
        petal.style.setProperty('--vm-x', `${Math.random() * 96}vw`);
        petal.style.setProperty('--vm-drift', `${(Math.random() - 0.5) * 28}vw`);
        petal.style.setProperty('--vm-size', `${13 + Math.random() * 13}px`);
        petal.style.setProperty('--vm-fall', `${5 + Math.random() * 4}s`);
        petal.style.setProperty('--vm-delay', `${Math.random() * 1.8}s`);
        petal.style.setProperty('--vm-spin', `${1.6 + Math.random() * 1.8}s`);
        petal.style.setProperty('--vm-rot', `${Math.random() * 360}deg`);
        petal.innerHTML =
          `<svg viewBox="0 0 24 24" aria-hidden="true">` +
          `<path d="M12 2c4.2 4.4 6 8.4 6 12 0 5.2-2.7 8-6 8s-6-2.8-6-8c0-3.6 1.8-7.6 6-12Z" fill="${outer}"/>` +
          `<path d="M12 7.5c2.3 2.9 3.2 5.3 3.2 7.6 0 3-1.4 4.7-3.2 4.7s-3.2-1.7-3.2-4.7c0-2.3.9-4.7 3.2-7.6Z" fill="${inner}"/>` +
          `</svg>`;
        document.body.appendChild(petal);
        setTimeout(() => petal.remove(), 11_000);
      }
    }

    /** Thêm một ngọn nến mới vào dãy, có hiệu ứng bùng lên. */
    function addCandleToWall() {
      if (!wall) return;
      const template = wall.querySelector('.vm-candle');
      const candle = template
        ? (template.cloneNode(true) as HTMLElement)
        : document.createElement('span');

      if (!template) {
        // Dãy đang trống (chưa ai thắp): dựng nến đầu tiên từ đầu
        candle.className = 'vm-candle is-lit';
        candle.style.setProperty('--vm-candle-width', '18px');
        candle.innerHTML =
          `<span class="vm-candle-glow"></span>` +
          `<svg viewBox="0 0 24 46" fill="none" xmlns="http://www.w3.org/2000/svg">` +
          `<g class="vm-candle-flame">` +
          `<path d="M12 3c3.4 4.9 5 8 5 10.9C17 17.8 14.8 20.4 12 20.4s-5-2.6-5-6.5C7 11 8.6 7.9 12 3Z" fill="#f0951f"/>` +
          `<path d="M12 8.2c1.9 3.2 2.6 4.8 2.6 6.4 0 2.3-1.2 3.8-2.6 3.8s-2.6-1.5-2.6-3.8c0-1.6.7-3.2 2.6-6.4Z" fill="#ffdc7a"/>` +
          `<path d="M12 12.6c.8 1.6 1.1 2.4 1.1 3.1 0 1-.5 1.7-1.1 1.7s-1.1-.7-1.1-1.7c0-.7.3-1.5 1.1-3.1Z" fill="#fff8e1"/>` +
          `</g>` +
          `<path class="vm-candle-wick" d="M12 19.5v3.6" stroke="#4a3f38" stroke-width="1.4" stroke-linecap="round"/>` +
          `<rect x="6.5" y="22.5" width="11" height="22" rx="3.2" fill="#f5e3d0"/>` +
          `<rect x="6.5" y="22.5" width="11" height="22" rx="3.2" stroke="rgba(90,60,40,.18)" stroke-width="1"/>` +
          `<path d="M9 25.5v16" stroke="rgba(255,255,255,.75)" stroke-width="1.6" stroke-linecap="round"/>` +
          `<ellipse cx="12" cy="23.2" rx="5.5" ry="1.5" fill="#e6cdb4"/>` +
          `</svg>`;
      }

      candle.classList.add('is-lit', 'vm-candle-new');
      candle.style.setProperty('--vm-candle-delay', '0s');
      wall.appendChild(candle);

      // Giữ dãy không dài quá hạn mức
      const all = wall.querySelectorAll('.vm-candle');
      if (all.length > wallLimit) all[0]!.remove();
    }

    function updateSummary(candles?: number, flowers?: number) {
      if (!summary) return;
      const parts: string[] = [];
      if (typeof candles === 'number' && candles > 0) {
        parts.push(`${candles.toLocaleString('vi-VN')} ngọn nến đã được thắp`);
      }
      if (typeof flowers === 'number' && flowers > 0) {
        parts.push(`${flowers.toLocaleString('vi-VN')} cánh hoa đã thả`);
      }
      if (parts.length === 0) return;
      summary.textContent = parts.join(' · ');
      summary.classList.remove('vm-count-bump');
      // Buộc trình duyệt chạy lại animation
      void summary.offsetWidth;
      summary.classList.add('vm-count-bump');
    }

    /** Đổi nút sang trạng thái đã gửi. */
    function markDone(button: HTMLButtonElement) {
      button.disabled = true;
      const label = button.querySelector<HTMLElement>('[data-tribute-label]');
      if (label && button.dataset.labelDone) label.textContent = button.dataset.labelDone;
      button.querySelector('.vm-candle')?.classList.add('is-lit');
    }

    tributes.querySelectorAll<HTMLButtonElement>('[data-tribute]').forEach((button) => {
      button.addEventListener('click', async () => {
        const type = button.dataset.tribute!;
        button.disabled = true;
        if (status) status.textContent = '';

        try {
          const response = await fetch('/api/tribute', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ slug, type }),
          });
          const data = (await response.json()) as {
            candles?: number;
            flowers?: number;
            alreadyDone?: boolean;
            error?: string;
          };

          if (!response.ok) {
            if (status) status.textContent = data.error ?? 'Chưa gửi được, bạn thử lại nhé.';
            button.disabled = false;
            return;
          }

          updateSummary(data.candles, data.flowers);
          markDone(button);

          if (data.alreadyDone) {
            if (status) status.textContent = 'Hôm nay bạn đã gửi rồi — cảm ơn bạn.';
            return;
          }

          if (type === 'candle') {
            addCandleToWall();
            if (status) status.textContent = 'Ngọn nến của bạn đã được thắp. Cảm ơn bạn.';
          } else {
            rainPetals();
            if (status) status.textContent = 'Cánh hoa của bạn đang bay. Cảm ơn bạn.';
          }
        } catch {
          if (status) status.textContent = 'Mất kết nối, bạn thử lại nhé.';
          button.disabled = false;
        }
      });
    });
  }

  // ── Chia sẻ ─────────────────────────────────────────────────────────────
  const shareButton = document.querySelector<HTMLButtonElement>('[data-share]');
  if (shareButton) {
    shareButton.classList.remove('hidden');
    shareButton.addEventListener('click', async () => {
      const url = window.location.href;
      const title = document.title;
      if (navigator.share) {
        try {
          await navigator.share({ title, url });
          return;
        } catch {
          // người dùng huỷ — bỏ qua
        }
      }
      try {
        await navigator.clipboard.writeText(url);
        shareButton.textContent = 'Đã copy link ✓';
      } catch {
        window.prompt('Copy đường dẫn này:', url);
      }
    });
  }

  // ── Lightbox ────────────────────────────────────────────────────────────
  const lightbox = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  if (lightbox) {
    const image = lightbox.querySelector<HTMLImageElement>('[data-lightbox-image]')!;
    const caption = lightbox.querySelector<HTMLElement>('[data-lightbox-caption]')!;

    document.querySelectorAll<HTMLButtonElement>('[data-lightbox-open]').forEach((button) => {
      button.addEventListener('click', () => {
        const source = button.querySelector('img');
        if (!source) return;
        image.src = source.src;
        image.alt = source.alt;
        caption.textContent = source.alt;
        lightbox.showModal();
      });
    });

    lightbox.querySelector('[data-lightbox-close]')?.addEventListener('click', () => lightbox.close());
    lightbox.addEventListener('click', (event) => {
      if (event.target === lightbox) lightbox.close();
    });
  }
</script>
