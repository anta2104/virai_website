---
import { site, contact, navLinks } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-white/5 bg-slate-950 py-12">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-10 md:grid-cols-3">
      <div>
        <img src="/logo.svg" alt="Virai" class="h-8 w-auto" width="120" height="32" />
        <p class="mt-4 text-sm text-slate-400 leading-relaxed">
          {site.description}
        </p>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-white">Liên kết</h3>
        <ul class="mt-4 space-y-2">
          {
            navLinks.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-slate-400 transition-colors hover:text-white">
                  {link.label}
                </a>
              </li>
            ))
          }
          <li>
            <a href="#construction" class="text-sm text-slate-400 transition-colors hover:text-white">
              AI An toàn công trường
            </a>
          </li>
          <li>
            <a href="#elderly-care" class="text-sm text-slate-400 transition-colors hover:text-white">
              AI Chăm sóc người cao tuổi
            </a>
          </li>
          <li>
            <a href="#ai-agent" class="text-sm text-slate-400 transition-colors hover:text-white">
              AI Agent + LLM
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-white">Liên hệ</h3>
        <ul class="mt-4 space-y-2 text-sm text-slate-400">
          <li>
            <a href={`mailto:${contact.email}`} class="hover:text-white transition-colors">
              {contact.email}
            </a>
          </li>
          <li>
            <a href={`tel:${contact.phone.replace(/\s/g, '')}`} class="hover:text-white transition-colors">
              {contact.phone}
            </a>
          </li>
          <li>{contact.address}</li>
        </ul>
      </div>
    </div>

    <div class="mt-10 flex flex-col items-center justify-between gap-4 border-t border-white/5 pt-8 sm:flex-row">
      <p class="text-sm text-slate-500">
        © {year} {site.name}. Bảo lưu mọi quyền.
      </p>
      <p class="text-sm text-slate-500">
        <a href={site.url} class="hover:text-virai-400 transition-colors">virai.com.vn</a>
      </p>
    </div>
  </div>
</footer>
