---
import { about as defaultAbout, aboutHighlights as defaultAboutHighlights } from '../data/site';

const {
  about = defaultAbout,
  aboutHighlights = defaultAboutHighlights,
  eyebrow = 'Giới thiệu',
} = Astro.props;
---

<section id="about" class="section-padding">
  <div class="mx-auto max-w-7xl">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-semibold uppercase tracking-widest text-virai-400">
        {eyebrow}
      </p>
      <h2 class="mt-3 text-3xl font-bold text-white sm:text-4xl">{about.title}</h2>
    </div>

    <div class="mx-auto mt-12 max-w-3xl space-y-6 text-center text-lg leading-relaxed text-slate-400">
      {about.paragraphs.map((p) => <p>{p}</p>)}
    </div>

    <div class="mt-16 grid gap-6 sm:grid-cols-3">
      {
        aboutHighlights.map((item) => (
          <div class="glass rounded-2xl p-6 text-center">
            <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-virai-600/20">
              <svg
                class="h-6 w-6 text-virai-400"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.5"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
              </svg>
            </div>
            <h3 class="font-semibold text-white">{item.title}</h3>
            <p class="mt-2 text-sm text-slate-400">{item.desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
