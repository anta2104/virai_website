---
import { hero as defaultHero } from '../data/site';

const { hero = defaultHero } = Astro.props;
---

<section class="relative flex min-h-screen items-center overflow-hidden pt-20">
  <div class="absolute inset-0">
    <img
      src="/images/hero/hero-bg.jpg"
      alt=""
      class="h-full w-full object-cover opacity-20"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-slate-950/60 via-slate-950/90 to-slate-950"></div>
    <div
      class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-virai-900/40 via-transparent to-transparent"
    />
  </div>

  <div class="relative mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8 lg:py-32">
    <div class="max-w-3xl">
      <p
        class="mb-4 inline-flex items-center gap-2 rounded-full border border-virai-500/30 bg-virai-500/10 px-4 py-1.5 text-sm font-medium text-virai-300"
      >
        <span class="h-2 w-2 rounded-full bg-cyan-400 animate-pulse"></span>
        {hero.eyebrow}
      </p>
      <h1 class="text-4xl font-bold leading-tight tracking-tight sm:text-5xl lg:text-6xl">
        <span class="text-gradient">{hero.titlePrefix}</span> {hero.titleSuffix}
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-slate-400 sm:text-xl">
        {hero.description}
      </p>
      <div class="mt-10 flex flex-wrap gap-4">
        <a
          href="#solutions"
          class="rounded-xl bg-virai-600 px-6 py-3.5 text-sm font-semibold text-white shadow-lg shadow-virai-600/25 transition-all hover:bg-virai-500 hover:shadow-virai-500/30"
        >
          {hero.primaryCta}
        </a>
        <a
          href="#contact"
          class="rounded-xl border border-white/15 bg-white/5 px-6 py-3.5 text-sm font-semibold text-white backdrop-blur transition-all hover:bg-white/10"
        >
          {hero.secondaryCta}
        </a>
      </div>
    </div>

    <div class="mt-16 grid grid-cols-1 gap-4 sm:grid-cols-3">
      {
        hero.stats.map((stat) => (
          <div class="glass rounded-xl px-6 py-4 text-center sm:text-left">
            <p class="text-2xl font-bold text-gradient">{stat.value}</p>
            <p class="mt-1 text-sm text-slate-400">{stat.label}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
