---
interface Props {
  /** Nến đã thắp thì có lửa và vầng sáng, chưa thắp thì chỉ còn tim nến */
  lit?: boolean;
  /** Lệch pha animation để cả dãy nến không lay cùng nhịp */
  delay?: number;
  size?: 'sm' | 'md';
  class?: string;
}

const { lit = true, delay = 0, size = 'md', class: className = '' } = Astro.props;
const width = size === 'sm' ? 22 : 28;
---

<span
  class:list={['vm-candle', lit && 'is-lit', className]}
  style={`--vm-candle-delay:${delay.toFixed(2)}s;--vm-candle-width:${width}px`}
  aria-hidden="true"
>
  <span class="vm-candle-glow"></span>
  <svg viewBox="0 0 24 46" fill="none" xmlns="http://www.w3.org/2000/svg">
    <!-- Ngọn lửa: hai lớp lồng nhau, lớp ngoài cam, lớp trong vàng sáng -->
    <g class="vm-candle-flame">
      <path
        d="M12 3c3.4 4.9 5 8 5 10.9C17 17.8 14.8 20.4 12 20.4s-5-2.6-5-6.5C7 11 8.6 7.9 12 3Z"
        fill="#f0951f"
      />
      <path
        d="M12 8.2c1.9 3.2 2.6 4.8 2.6 6.4 0 2.3-1.2 3.8-2.6 3.8s-2.6-1.5-2.6-3.8c0-1.6.7-3.2 2.6-6.4Z"
        fill="#ffdc7a"
      />
      <path
        d="M12 12.6c.8 1.6 1.1 2.4 1.1 3.1 0 1-.5 1.7-1.1 1.7s-1.1-.7-1.1-1.7c0-.7.3-1.5 1.1-3.1Z"
        fill="#fff8e1"
      />
    </g>

    <!-- Tim nến -->
    <path class="vm-candle-wick" d="M12 19.5v3.6" stroke="#4a3f38" stroke-width="1.4" stroke-linecap="round" />

    <!-- Thân nến: viền và mảng tối bên phải để nổi trên cả nền kem lẫn nền đêm -->
    <rect x="6.5" y="22.5" width="11" height="22" rx="3.2" fill="#f7e7d5" />
    <path d="M14 22.8h.3a3.2 3.2 0 0 1 3.2 3.2v15.3a3.2 3.2 0 0 1-3.2 3.2H14V22.8Z" fill="#e0c3a5" />
    <rect
      x="6.5"
      y="22.5"
      width="11"
      height="22"
      rx="3.2"
      stroke="rgba(88,58,38,.34)"
      stroke-width="1.1"
    />
    <path d="M9.2 26v15" stroke="rgba(255,255,255,.9)" stroke-width="1.5" stroke-linecap="round" />
    <ellipse cx="12" cy="23.2" rx="5.5" ry="1.6" fill="#e8d0b8" stroke="rgba(88,58,38,.28)" stroke-width="0.9" />
  </svg>
</span>
