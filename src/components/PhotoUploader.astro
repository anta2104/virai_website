---
interface Props {
  memorialId: string;
  used: number;
  /** null = không giới hạn */
  limit: number | null;
  allowVideo: boolean;
}

const { memorialId, used, limit, allowVideo } = Astro.props;
const accept = allowVideo ? 'image/jpeg,image/png,image/webp,video/mp4' : 'image/jpeg,image/png,image/webp';
const remaining = limit === null ? null : Math.max(0, limit - used);
---

<div
  class="rounded-2xl border-2 border-dashed border-cream-400 bg-white/60 p-6 text-center"
  data-uploader
  data-memorial-id={memorialId}
  data-remaining={remaining === null ? '' : String(remaining)}
>
  <p class="text-sm text-ink-500">
    Kéo ảnh vào đây hoặc bấm để chọn.
    {
      limit === null ? (
        <span>Bạn tải bao nhiêu ảnh cũng được.</span>
      ) : (
        <span>
          Còn <strong data-remaining-label>{remaining}</strong> chỗ trong gói hiện tại.
        </span>
      )
    }
  </p>
  {
    allowVideo && (
      <p class="hint">Gói Premium: bạn tải được cả video MP4 (tối đa 40MB).</p>
    )
  }

  <label class="btn-secondary mt-4 cursor-pointer">
    Chọn tệp
    <input type="file" class="sr-only" multiple accept={accept} data-file-input />
  </label>

  <p class="mt-3 text-sm" data-upload-status role="status" aria-live="polite"></p>
  <p class="alert-error mt-3 hidden text-left" data-upload-error></p>
</div>

<script>
  const MAX_SIDE = 1600;
  const JPEG_QUALITY = 0.85;

  /** Thu nhỏ ảnh ngay trên máy người dùng để tải lên nhanh và tiết kiệm dữ liệu. */
  async function shrink(file: File): Promise<{ blob: Blob; width: number; height: number; name: string }> {
    if (!file.type.startsWith('image/')) {
      return { blob: file, width: 0, height: 0, name: file.name };
    }

    try {
      const bitmap = await createImageBitmap(file);
      // Đọc kích thước gốc trước khi close(): sau khi close, bitmap.width/height về 0
      const sourceWidth = bitmap.width;
      const sourceHeight = bitmap.height;
      const scale = Math.min(1, MAX_SIDE / Math.max(sourceWidth, sourceHeight));
      const width = Math.round(sourceWidth * scale);
      const height = Math.round(sourceHeight * scale);

      const canvas = document.createElement('canvas');
      canvas.width = width;
      canvas.height = height;
      const context = canvas.getContext('2d');
      if (!context) throw new Error('Không tạo được canvas');
      context.drawImage(bitmap, 0, 0, width, height);
      bitmap.close();

      const blob = await new Promise<Blob | null>((resolve) =>
        canvas.toBlob(resolve, 'image/jpeg', JPEG_QUALITY),
      );
      if (!blob || blob.size >= file.size) {
        return { blob: file, width: sourceWidth, height: sourceHeight, name: file.name };
      }
      return { blob, width, height, name: file.name.replace(/\.[^.]+$/, '') + '.jpg' };
    } catch {
      // Trình duyệt cũ không hỗ trợ createImageBitmap → tải nguyên bản
      return { blob: file, width: 0, height: 0, name: file.name };
    }
  }

  function setup(root: HTMLElement) {
    const memorialId = root.dataset.memorialId!;
    const input = root.querySelector<HTMLInputElement>('[data-file-input]')!;
    const status = root.querySelector<HTMLElement>('[data-upload-status]')!;
    const errorBox = root.querySelector<HTMLElement>('[data-upload-error]')!;
    let busy = false;

    const showError = (message: string) => {
      errorBox.textContent = message;
      errorBox.classList.remove('hidden');
    };

    async function uploadAll(files: File[]) {
      if (busy || files.length === 0) return;
      busy = true;
      errorBox.classList.add('hidden');
      let done = 0;

      for (const file of files) {
        status.textContent = `Đang tải ${done + 1}/${files.length}…`;
        try {
          const prepared = await shrink(file);
          const body = new FormData();
          body.set('memorialId', memorialId);
          body.set('file', prepared.blob, prepared.name);
          if (prepared.width) body.set('width', String(prepared.width));
          if (prepared.height) body.set('height', String(prepared.height));

          const response = await fetch('/api/upload', { method: 'POST', body });
          const data = (await response.json()) as { error?: string };
          if (!response.ok) {
            showError(data.error ?? 'Tải ảnh không thành công.');
            break;
          }
          done++;
        } catch {
          showError('Mất kết nối khi đang tải ảnh. Bạn thử lại nhé.');
          break;
        }
      }

      busy = false;
      status.textContent = done > 0 ? `Đã tải ${done} tệp.` : '';
      if (done > 0) {
        window.location.reload();
      }
    }

    input.addEventListener('change', () => {
      void uploadAll(Array.from(input.files ?? []));
      input.value = '';
    });

    for (const eventName of ['dragenter', 'dragover'] as const) {
      root.addEventListener(eventName, (event) => {
        event.preventDefault();
        root.classList.add('border-clay-400', 'bg-clay-50');
      });
    }
    for (const eventName of ['dragleave', 'drop'] as const) {
      root.addEventListener(eventName, () => {
        root.classList.remove('border-clay-400', 'bg-clay-50');
      });
    }
    root.addEventListener('drop', (event) => {
      event.preventDefault();
      void uploadAll(Array.from(event.dataTransfer?.files ?? []));
    });
  }

  document.querySelectorAll<HTMLElement>('[data-uploader]').forEach(setup);
</script>
