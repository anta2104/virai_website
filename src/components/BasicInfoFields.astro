---
import LunarDateField from './LunarDateField.astro';
import { GENDER_OPTIONS, SPECIES_OPTIONS, type BasicInfo } from '../lib/memorial-form';
import { MODE_OPTIONS, isLiving } from '../lib/memorial-mode';
import { todayInVietnam } from '../lib/format';

interface Props {
  values: BasicInfo;
  /**
   * Cho đổi chế độ hay không. Lúc tạo mới thì cho; lúc sửa trang đã có thì
   * không — chuyển chế độ là việc nhạy cảm, đi qua nút riêng có xác nhận.
   */
  allowModeChange?: boolean;
}

const { values, allowModeChange = false } = Astro.props;
const today = todayInVietnam();
const living = isLiving(values.mode);
---

<div class="space-y-5" data-basic-info>
  {
    allowModeChange ? (
      <fieldset>
        <legend class="label">Trang này dành cho</legend>
        <div class="grid gap-3 sm:grid-cols-2">
          {MODE_OPTIONS.map((option) => (
            <label class="cursor-pointer">
              <input
                type="radio"
                name="mode"
                value={option.value}
                checked={values.mode === option.value}
                class="peer sr-only"
                data-mode-input
              />
              <span class="block h-full rounded-2xl border border-cream-300 p-4 transition peer-checked:border-clay-400 peer-checked:bg-clay-50">
                <span class="block font-medium text-ink-900">{option.label}</span>
                <span class="mt-1 block text-sm text-ink-500">{option.hint}</span>
              </span>
            </label>
          ))}
        </div>
      </fieldset>
    ) : (
      <input type="hidden" name="mode" value={values.mode} />
    )
  }

  <div>
    <label class="label" for="petName">Tên bé</label>
    <input
      class="input"
      id="petName"
      name="petName"
      required
      maxlength="60"
      value={values.petName}
      placeholder="Ví dụ: Mít"
    />
  </div>

  <fieldset>
    <legend class="label">Bé là</legend>
    <div class="flex flex-wrap gap-2">
      {
        SPECIES_OPTIONS.map((option) => (
          <label class="cursor-pointer">
            <input
              type="radio"
              name="species"
              value={option.value}
              checked={values.species === option.value}
              class="peer sr-only"
            />
            <span class="block rounded-full border border-cream-300 px-4 py-2 text-sm peer-checked:border-clay-400 peer-checked:bg-clay-50 peer-checked:text-clay-700">
              {option.label}
            </span>
          </label>
        ))
      }
    </div>
  </fieldset>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label class="label" for="breed">Giống loài</label>
      <input
        class="input"
        id="breed"
        name="breed"
        maxlength="80"
        value={values.breed}
        placeholder="Ví dụ: Golden Retriever"
      />
      <p class="hint">Không biết chính xác thì để trống.</p>
    </div>

    <div>
      <label class="label" for="gender">Giới tính</label>
      <select class="input" id="gender" name="gender">
        {
          GENDER_OPTIONS.map((option) => (
            <option value={option.value} selected={values.gender === option.value}>
              {option.label}
            </option>
          ))
        }
      </select>
    </div>
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <LunarDateField name="birthDate" label="Ngày sinh" value={values.birthDate} max={today} />
    <div data-death-date class:list={[living && 'hidden']}>
      <LunarDateField
        name="deathDate"
        label="Ngày bé rời đi"
        value={values.deathDate}
        max={today}
        hint="Dùng để tính ngày 49 và ngày giỗ."
      />
    </div>
  </div>
</div>

{
  allowModeChange && (
    <script>
      // Chọn "bé vẫn đang bên tôi" thì giấu ô ngày mất và xoá luôn giá trị đã gõ.
      // Không có JS thì ô vẫn hiện, và phía server tự bỏ qua ngày mất ở chế độ
      // living — nên form vẫn dùng được.
      const root = document.querySelector<HTMLElement>('[data-basic-info]');
      const deathField = root?.querySelector<HTMLElement>('[data-death-date]');
      const input = deathField?.querySelector<HTMLInputElement>('input[name="deathDate"]');

      function sync() {
        const mode = root?.querySelector<HTMLInputElement>('[data-mode-input]:checked')?.value;
        const living = mode === 'living';
        deathField?.classList.toggle('hidden', living);
        if (living && input) input.value = '';
      }

      root?.querySelectorAll('[data-mode-input]').forEach((el) => {
        el.addEventListener('change', sync);
      });
      sync();
    </script>
  )
}
