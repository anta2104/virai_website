---
import BaseLayout from './BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site } from '../lib/site';

interface Props {
  title: string;
  /** Nhãn nhỏ phía trên tiêu đề, cho biết đang ở phần nào */
  eyebrow?: string;
  /** Một dòng giải thích ngắn dưới tiêu đề */
  description?: string;
  backHref?: string;
  backLabel?: string;
  wide?: boolean;
}

const {
  title,
  eyebrow,
  description,
  backHref,
  backLabel = 'Quay lại',
  wide = false,
} = Astro.props;

const user = Astro.locals.user!;
const path = Astro.url.pathname;

const navItems = [
  { href: '/tai-khoan', label: 'Trang kỷ niệm' },
  { href: '/tai-khoan/don-hang', label: 'Đơn hàng' },
];
---

<BaseLayout title={`${title} · ${site.name}`} noindex>
  <div class="flex min-h-screen flex-col bg-cream-50">
    <header class="sticky top-0 z-40 border-b border-cream-300 bg-cream-50/95 backdrop-blur">
      <div class="mx-auto flex w-full max-w-6xl items-center gap-6 px-4 py-3 sm:px-6 lg:px-8">
        <a href="/" class="flex shrink-0 items-center gap-2.5">
          <span
            class="flex h-8 w-8 items-center justify-center rounded-full bg-clay-500 font-serif text-white"
            aria-hidden="true">V</span
          >
          <span class="hidden font-serif font-semibold text-ink-900 sm:inline">{site.name}</span>
        </a>

        <nav class="flex items-center gap-5 text-sm" aria-label="Khu vực tài khoản">
          {
            navItems.map((item) => {
              const active = path === item.href;
              return (
                <a
                  href={item.href}
                  aria-current={active ? 'page' : undefined}
                  class:list={[
                    'py-1 transition',
                    active
                      ? 'font-medium text-ink-900 underline decoration-clay-400 decoration-2 underline-offset-[7px]'
                      : 'text-ink-500 hover:text-ink-900',
                  ]}
                >
                  {item.label}
                </a>
              );
            })
          }
          {
            user.role === 'admin' && (
              <a
                href="/admin"
                class:list={[
                  'py-1 transition',
                  path.startsWith('/admin')
                    ? 'font-medium text-ink-900'
                    : 'text-ink-500 hover:text-ink-900',
                ]}
              >
                Quản trị
              </a>
            )
          }
        </nav>

        <div class="ml-auto flex items-center gap-4">
          <span class="hidden text-sm text-ink-500 sm:inline">{user.name}</span>
          <form method="POST" action="/dang-xuat">
            <button type="submit" class="text-sm text-ink-500 transition hover:text-ink-900">
              Đăng xuất
            </button>
          </form>
        </div>
      </div>
    </header>

    <main class="flex-1 px-4 py-10 sm:px-6 lg:px-8">
      <div class:list={['mx-auto w-full', wide ? 'max-w-6xl' : 'max-w-3xl']}>
        {
          backHref && (
            <a
              href={backHref}
              class="mb-6 inline-flex items-center gap-2 text-sm text-ink-500 transition hover:text-clay-700"
            >
              <Icon name="arrow-left" size={16} />
              {backLabel}
            </a>
          )
        }

        <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-4">
          <div>
            {eyebrow && <p class="eyebrow">{eyebrow}</p>}
            <h1 class:list={['font-serif text-3xl font-semibold sm:text-4xl', eyebrow && 'mt-2.5']}>
              {title}
            </h1>
            {description && <p class="measure mt-3 text-ink-500">{description}</p>}
          </div>
          <slot name="actions" />
        </div>

        <div class="mt-8">
          <slot />
        </div>
      </div>
    </main>
  </div>
</BaseLayout>
