---
import BaseLayout from './BaseLayout.astro';
import { site } from '../lib/site';

interface Props {
  title: string;
  /** Hiển thị breadcrumb quay lại */
  backHref?: string;
  backLabel?: string;
  wide?: boolean;
}

const { title, backHref, backLabel = 'Quay lại', wide = false } = Astro.props;
const user = Astro.locals.user!;
const path = Astro.url.pathname;

const navItems = [
  { href: '/tai-khoan', label: 'Trang kỷ niệm' },
  { href: '/tai-khoan/don-hang', label: 'Đơn hàng' },
];
---

<BaseLayout title={`${title} · ${site.name}`} noindex>
  <div class="flex min-h-screen flex-col bg-cream-100">
    <header class="border-b border-cream-300 bg-cream-50">
      <div class="container-page flex items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8">
        <a href="/" class="flex items-center gap-2.5">
          <span
            class="flex h-8 w-8 items-center justify-center rounded-full bg-clay-500 font-serif text-white"
            aria-hidden="true">V</span
          >
          <span class="hidden font-serif font-semibold text-ink-900 sm:inline">{site.name}</span>
        </a>

        <nav class="flex items-center gap-1" aria-label="Khu vực tài khoản">
          {
            navItems.map((item) => (
              <a
                href={item.href}
                class:list={[
                  'rounded-full px-3 py-1.5 text-sm transition',
                  path === item.href
                    ? 'bg-cream-200 text-ink-900'
                    : 'text-ink-500 hover:text-ink-900',
                ]}
              >
                {item.label}
              </a>
            ))
          }
          {
            user.role === 'admin' && (
              <a href="/admin" class="rounded-full px-3 py-1.5 text-sm text-ink-500 hover:text-ink-900">
                Quản trị
              </a>
            )
          }
        </nav>

        <div class="flex items-center gap-3">
          <span class="hidden text-sm text-ink-500 sm:inline">{user.name}</span>
          <form method="POST" action="/dang-xuat">
            <button type="submit" class="btn-ghost btn-sm">Đăng xuất</button>
          </form>
        </div>
      </div>
    </header>

    <main class="flex-1 px-4 py-8 sm:px-6 lg:px-8">
      <div class:list={['mx-auto w-full', wide ? 'max-w-6xl' : 'max-w-3xl']}>
        {
          backHref && (
            <a href={backHref} class="mb-4 inline-flex items-center gap-1 text-sm text-ink-500 hover:text-clay-600">
              <span aria-hidden="true">←</span> {backLabel}
            </a>
          )
        }
        <h1 class="mb-6 font-serif text-2xl font-semibold sm:text-3xl">{title}</h1>
        <slot />
      </div>
    </main>
  </div>
</BaseLayout>
