---
import AppLayout from '../../layouts/AppLayout.astro';
import Icon from '../../components/Icon.astro';
import { currentUser } from '../../lib/guards';
import { listMemorialsOfUser, listPhotos, photoUrl } from '../../lib/memorials';
import { formatDate } from '../../lib/format';
import { upcomingMilestone } from '../../lib/memorial-dates';
import { LIMITS } from '../../lib/plans';
import { env } from '../../lib/env';

const user = currentUser(Astro.locals);

const memorials = await listMemorialsOfUser(env.DB, user.id);
const cards = await Promise.all(
  memorials.map(async (memorial) => {
    const photos = await listPhotos(env.DB, memorial.id);
    const cover = photos.find((photo) => photo.id === memorial.coverPhotoId) ?? photos[0] ?? null;
    return {
      memorial,
      cover,
      photoCount: photos.length,
      next: upcomingMilestone(memorial.deathDate),
    };
  }),
);

const freeCount = memorials.filter((memorial) => !memorial.isPremium).length;
const canCreate = freeCount < LIMITS.free.memorials;
const deleted = Astro.url.searchParams.has('deleted');
---

<AppLayout
  title="Trang kỷ niệm của bạn"
  eyebrow="Tài khoản"
  description={memorials.length > 0 ? undefined : 'Nơi bạn tạo và chăm sóc trang cho từng bé.'}
  wide
>
  {
    canCreate && memorials.length > 0 && (
      <a slot="actions" href="/tai-khoan/tao-trang" class="btn-primary">
        <Icon name="plus" size={17} />
        Tạo trang cho bé khác
      </a>
    )
  }

  {deleted && <p class="alert-success mb-8">Đã xoá trang kỷ niệm.</p>}

  {
    cards.length === 0 ? (
      <div class="rule pt-16 text-center">
        <span class="inline-flex text-cream-400">
          <Icon name="paw" size={44} weight={1.25} />
        </span>
        <h2 class="mt-5 font-serif text-xl font-semibold">Bạn chưa có trang nào</h2>
        <p class="measure mx-auto mt-3 text-ink-500">
          Bắt đầu bằng tên bé và một tấm ảnh. Phần còn lại làm dần cũng được — trang giữ ở dạng nháp
          cho tới khi bạn bấm xuất bản.
        </p>
        <a href="/tai-khoan/tao-trang" class="btn-primary mt-7">
          <Icon name="plus" size={17} />
          Tạo trang cho bé
        </a>
      </div>
    ) : (
      <>
        <ul>
          {cards.map(({ memorial, cover, photoCount, next }) => (
            <li class="border-t border-cream-300 last:border-b">
              <a
                href={`/tai-khoan/be/${memorial.id}`}
                class="group flex items-center gap-5 py-5"
              >
                <span class="h-16 w-16 shrink-0 overflow-hidden rounded-lg bg-cream-200 sm:h-20 sm:w-20">
                  {cover ? (
                    <img
                      src={photoUrl(cover.r2Key)}
                      alt=""
                      class="h-full w-full object-cover"
                      loading="lazy"
                    />
                  ) : (
                    <span class="flex h-full items-center justify-center text-cream-400">
                      <Icon name="paw" size={26} />
                    </span>
                  )}
                </span>

                <span class="min-w-0 flex-1">
                  <span class="flex flex-wrap items-center gap-x-2.5 gap-y-1">
                    <span class="font-serif text-lg font-semibold text-ink-900">
                      {memorial.petName}
                    </span>
                    {Boolean(memorial.isPremium) && (
                      <span class="badge bg-clay-100 text-clay-700">Premium</span>
                    )}
                    {memorial.isPublished ? (
                      <span class="badge bg-sage-100 text-sage-700">Công khai</span>
                    ) : (
                      <span class="badge bg-cream-200 text-ink-500">Nháp</span>
                    )}
                  </span>

                  <span class="mt-1 block text-sm text-ink-500 tabular-nums">
                    {[formatDate(memorial.birthDate), formatDate(memorial.deathDate)]
                      .filter(Boolean)
                      .join(' — ') || 'Chưa có ngày tháng'}
                  </span>

                  <span class="mt-1 block text-xs text-ink-500">
                    {photoCount} ảnh · {memorial.visitCount.toLocaleString('vi-VN')} lượt ghé thăm
                    {memorial.candleCount > 0 &&
                      ` · ${memorial.candleCount.toLocaleString('vi-VN')} ngọn nến`}
                  </span>

                  {next && (
                    <span class="mt-2 block text-xs text-clay-700">
                      Sắp tới: {next.label} — {formatDate(next.date)}
                    </span>
                  )}
                </span>

                <span class="shrink-0 text-cream-400 transition group-hover:translate-x-0.5 group-hover:text-clay-500">
                  <Icon name="chevron-right" size={20} />
                </span>
              </a>
            </li>
          ))}
        </ul>

        {!canCreate && (
          <p class="alert-info mt-8">
            Gói miễn phí cho một trang kỷ niệm. Nâng cấp trang hiện tại lên Premium là bạn tạo thêm
            được bé mới.
          </p>
        )}
      </>
    )
  }
</AppLayout>
