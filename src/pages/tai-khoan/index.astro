---
import AppLayout from '../../layouts/AppLayout.astro';
import Icon from '../../components/Icon.astro';
import { currentUser } from '../../lib/guards';
import { listMemorialsOfUser, listPhotos, photoUrl } from '../../lib/memorials';
import { formatDate } from '../../lib/format';
import { upcomingMilestone } from '../../lib/memorial-dates';
import { LIMITS } from '../../lib/plans';
import { env } from '../../lib/env';

const user = currentUser(Astro.locals);

const memorials = await listMemorialsOfUser(env.DB, user.id);
const cards = await Promise.all(
  memorials.map(async (memorial) => {
    const photos = await listPhotos(env.DB, memorial.id);
    const cover = photos.find((photo) => photo.id === memorial.coverPhotoId) ?? photos[0] ?? null;
    return {
      memorial,
      cover,
      photoCount: photos.length,
      next: upcomingMilestone(memorial.deathDate),
    };
  }),
);

const freeCount = memorials.filter((memorial) => !memorial.isPremium).length;
const canCreate = freeCount < LIMITS.free.memorials;
const deleted = Astro.url.searchParams.has('deleted');
---

<AppLayout title="Trang kỷ niệm của bạn" wide>
  {deleted && <p class="alert-success mb-6">Đã xoá trang kỷ niệm.</p>}

  {
    cards.length === 0 ? (
      <div class="card p-8 text-center">
        <p class="text-4xl" aria-hidden="true"></p>
        <h2 class="mt-4 font-serif text-xl font-semibold">Bạn chưa có trang nào</h2>
        <p class="mx-auto mt-2 max-w-md text-sm text-ink-500">
          Bắt đầu bằng tên bé và một tấm ảnh. Phần còn lại làm dần cũng được — trang lưu ở dạng nháp
          tới khi bạn bấm xuất bản.
        </p>
        <a href="/tai-khoan/tao-trang" class="btn-primary mt-6">Tạo trang cho bé</a>
      </div>
    ) : (
      <>
        <div class="grid gap-5 sm:grid-cols-2">
          {cards.map(({ memorial, cover, photoCount, next }) => (
            <a href={`/tai-khoan/be/${memorial.id}`} class="card group flex gap-4 p-4 transition hover:shadow-md">
              <div class="h-24 w-24 shrink-0 overflow-hidden rounded-xl bg-cream-200">
                {cover ? (
                  <img src={photoUrl(cover.r2Key)} alt="" class="h-full w-full object-cover" loading="lazy" />
                ) : (
                  <span class="flex h-full items-center justify-center text-2xl text-cream-400"><Icon name="paw" size={30} /></span>
                )}
              </div>
              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-center gap-1.5">
                  <h2 class="font-serif text-lg font-semibold">{memorial.petName}</h2>
                  {memorial.isPremium && <span class="badge bg-clay-100 text-clay-700">Premium</span>}
                  {memorial.isPublished ? (
                    <span class="badge bg-sage-100 text-sage-700">Công khai</span>
                  ) : (
                    <span class="badge bg-cream-200 text-ink-500">Nháp</span>
                  )}
                </div>
                <p class="mt-1 text-sm text-ink-500">
                  {[formatDate(memorial.birthDate), formatDate(memorial.deathDate)].filter(Boolean).join(' — ') ||
                    'Chưa có ngày tháng'}
                </p>
                <p class="mt-1 text-xs text-ink-500">
                  {photoCount} ảnh · {memorial.visitCount.toLocaleString('vi-VN')} lượt ghé thăm
                </p>
                {next && (
                  <p class="mt-2 text-xs text-clay-700">
                    Sắp tới: {next.label} — {formatDate(next.date)}
                  </p>
                )}
              </div>
            </a>
          ))}
        </div>

        <div class="mt-8">
          {canCreate ? (
            <a href="/tai-khoan/tao-trang" class="btn-primary">Tạo trang cho bé khác</a>
          ) : (
            <p class="alert-info">
              Gói miễn phí cho một trang kỷ niệm. Nâng cấp trang hiện tại lên Premium là bạn tạo thêm
              được bé mới.
            </p>
          )}
        </div>
      </>
    )
  }
</AppLayout>
