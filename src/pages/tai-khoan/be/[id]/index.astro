---
import { and, eq, sql } from 'drizzle-orm';
import Icon from '../../../../components/Icon.astro';
import AppLayout from '../../../../layouts/AppLayout.astro';
import { notFound, ownedMemorial } from '../../../../lib/guards';
import { getDb } from '../../../../lib/db';
import { guestbookEntries, memorials, photos as photosTable } from '../../../../lib/db/schema';
import { listPhotos, photoUrl } from '../../../../lib/memorials';
import { limitsFor, formatVnd, amountToCharge, THEMES } from '../../../../lib/plans';
import { formatDate } from '../../../../lib/format';
import { upcomingMilestone } from '../../../../lib/memorial-dates';
import { isLiving } from '../../../../lib/memorial-mode';
import { listRemindersOf, setRemindersEnabled } from '../../../../lib/reminders';
import { memorialUrl } from '../../../../lib/site';
import { env } from '../../../../lib/env';

let memorial = await ownedMemorial(Astro.locals, Astro.params.id);
if (!memorial) return notFound();

const db = getDb(env.DB);
let notice: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? '');
  const now = Math.floor(Date.now() / 1000);

  if (intent === 'unpublish') {
    await db.update(memorials).set({ isPublished: 0, updatedAt: now }).where(eq(memorials.id, memorial.id));
    return Astro.redirect(`${Astro.url.pathname}?unpublished=1`);
  }

  if (intent === 'publish') {
    await db.update(memorials).set({ isPublished: 1, updatedAt: now }).where(eq(memorials.id, memorial.id));
    return Astro.redirect(`${Astro.url.pathname}?published=1`);
  }

  if (intent === 'reminders') {
    const enabled = String(form.get('enabled') ?? '') === '1';
    await setRemindersEnabled(env.DB, memorial.id, enabled);
    return Astro.redirect(`${Astro.url.pathname}?reminders=${enabled ? 'on' : 'off'}`);
  }

  if (intent === 'garden') {
    const show = String(form.get('show') ?? '') === '1';
    await db
      .update(memorials)
      .set({ showInGarden: show ? 1 : 0, updatedAt: now })
      .where(eq(memorials.id, memorial.id));
    return Astro.redirect(`${Astro.url.pathname}?vuon=${show ? 'on' : 'off'}`);
  }

  if (intent === 'delete') {
    const confirmName = String(form.get('confirmName') ?? '').trim();
    if (confirmName !== memorial.petName) {
      notice = 'Tên chưa khớp nên chưa xoá gì cả.';
    } else {
      const all = await listPhotos(env.DB, memorial.id);
      await Promise.all(
        all.map((photo) =>
          env.BUCKET.delete(photo.r2Key).catch((error: unknown) =>
            console.error('Không xoá được object R2:', error),
          ),
        ),
      );
      await db.delete(photosTable).where(eq(photosTable.memorialId, memorial.id));
      await db.delete(memorials).where(eq(memorials.id, memorial.id));
      return Astro.redirect('/tai-khoan?deleted=1');
    }
  }
}

const params = Astro.url.searchParams;
if (params.get('published')) notice = 'Trang đã được xuất bản. Bạn chia sẻ link hoặc mã QR được rồi.';
if (params.get('unpublished')) notice = 'Trang đã chuyển về dạng nháp, người khác không xem được nữa.';
if (params.get('reminders') === 'on') notice = 'Đã bật email nhắc ngày tưởng niệm.';
if (params.get('reminders') === 'off') notice = 'Đã tắt email nhắc ngày tưởng niệm.';
if (params.get('paid')) notice = 'Đã nhận thanh toán — trang của bé đã lên Premium. Cảm ơn bạn!';
if (params.get('vuon') === 'on') {
  notice = `${memorial.petName} đã xuất hiện ở Vườn tưởng niệm chung. Bạn tắt lại bất cứ lúc nào.`;
}
if (params.get('vuon') === 'off') {
  notice = `Đã gỡ ${memorial.petName} khỏi Vườn tưởng niệm. Trang vẫn dùng bình thường qua link và mã QR.`;
}
if (params.get('chuyen-che-do') === 'xong') {
  notice = `Đã chuyển trang của ${memorial.petName} sang trang tưởng niệm. Các mốc theo âm lịch đã được tính sẵn.`;
}

const living = isLiving(memorial.mode);

const photos = await listPhotos(env.DB, memorial.id);
const limits = limitsFor(memorial.isPremium);
const cover = photos.find((photo) => photo.id === memorial.coverPhotoId) ?? photos[0] ?? null;

const pendingRows = await db
  .select({ n: sql<number>`count(*)` })
  .from(guestbookEntries)
  .where(and(eq(guestbookEntries.memorialId, memorial.id), eq(guestbookEntries.status, 'pending')));
const pendingCount = Number(pendingRows[0]?.n ?? 0);

const reminderList = await listRemindersOf(env.DB, memorial.id);
const remindersOn = reminderList.some((reminder) => reminder.enabled);
const nextMilestone = upcomingMilestone(memorial.deathDate);
const publicUrl = memorialUrl(memorial.slug, Astro.site?.origin);
const themeName = THEMES.find((theme) => theme.id === memorial.theme)?.name ?? memorial.theme;
---

<AppLayout
  title={memorial.petName}
  eyebrow="Trang kỷ niệm"
  backHref="/tai-khoan"
  backLabel="Tất cả trang kỷ niệm"
  wide
>
  <div slot="actions" class="flex flex-wrap items-center gap-2">
    {
      memorial.isPublished ? (
        <>
          <a href={`/be/${memorial.slug}`} class="btn-secondary">
            <Icon name="external" size={16} />
            Mở trang thật
          </a>
          <form method="POST">
            <input type="hidden" name="intent" value="unpublish" />
            <button type="submit" class="btn-ghost">Chuyển về nháp</button>
          </form>
        </>
      ) : (
        <>
          <a href={`/tai-khoan/be/${memorial.id}/xem-truoc`} class="btn-secondary">
            <Icon name="eye" size={16} />
            Xem trước
          </a>
          <form method="POST">
            <input type="hidden" name="intent" value="publish" />
            <button type="submit" class="btn-primary">Xuất bản</button>
          </form>
        </>
      )
    }
  </div>

  {notice && <p class="alert-success mb-8">{notice}</p>}

  <div class="grid gap-x-14 gap-y-10 lg:grid-cols-[1.35fr_0.65fr]">
    <div>
      <!-- Tóm tắt: ảnh bìa, trạng thái, số liệu -->
      <div class="flex items-start gap-5 border-b border-cream-300 pb-7">
        <span class="h-24 w-24 shrink-0 overflow-hidden rounded-xl bg-cream-200">
          {
            cover ? (
              <img src={photoUrl(cover.r2Key)} alt="" class="h-full w-full object-cover" />
            ) : (
              <span class="flex h-full items-center justify-center text-cream-400">
                <Icon name="paw" size={32} />
              </span>
            )
          }
        </span>

        <div class="min-w-0 flex-1">
          <div class="flex flex-wrap items-center gap-2">
            {
              memorial.isPremium ? (
                <span class="badge bg-clay-100 text-clay-700">Premium</span>
              ) : (
                <span class="badge bg-cream-200 text-ink-500">Miễn phí</span>
              )
            }
            {
              memorial.isPublished ? (
                <span class="badge bg-sage-100 text-sage-700">Đang công khai</span>
              ) : (
                <span class="badge bg-cream-200 text-ink-500">Nháp</span>
              )
            }
          </div>
          <p class="mt-2 text-sm text-ink-500 tabular-nums">
            {[formatDate(memorial.birthDate), formatDate(memorial.deathDate)].filter(Boolean).join(' — ') ||
              'Chưa có ngày tháng'}
          </p>
          {memorial.deathDateLunar && <p class="text-sm text-ink-500">{memorial.deathDateLunar}</p>}
        </div>
      </div>

      <dl class="grid grid-cols-3 border-b border-cream-300 py-6 text-center">
        <div>
          <dt class="text-xs text-ink-500">Lượt ghé thăm</dt>
          <dd class="mt-1 font-serif text-2xl text-ink-900 tabular-nums">
            {memorial.visitCount.toLocaleString('vi-VN')}
          </dd>
        </div>
        <div class="border-x border-cream-300">
          <dt class="text-xs text-ink-500">Ngọn nến</dt>
          <dd class="mt-1 font-serif text-2xl text-ink-900 tabular-nums">
            {memorial.candleCount.toLocaleString('vi-VN')}
          </dd>
        </div>
        <div>
          <dt class="text-xs text-ink-500">Cánh hoa</dt>
          <dd class="mt-1 font-serif text-2xl text-ink-900 tabular-nums">
            {memorial.flowerCount.toLocaleString('vi-VN')}
          </dd>
        </div>
      </dl>

      <!-- Các mục chỉnh sửa -->
      <h2 class="mt-10 font-serif text-xl font-semibold">Chỉnh sửa trang</h2>
      <ul class="mt-4">
        {
          [
            {
              icon: 'pencil' as const,
              href: `/tai-khoan/be/${memorial.id}/thong-tin`,
              title: 'Thông tin về bé',
              note: 'Tên, giống loài, ngày sinh, ngày rời đi, đường dẫn',
            },
            {
              icon: 'image' as const,
              href: `/tai-khoan/be/${memorial.id}/anh`,
              title: 'Ảnh và video',
              note:
                limits.photos === Number.POSITIVE_INFINITY
                  ? `${photos.length} tệp`
                  : `${photos.length} / ${limits.photos} tệp`,
            },
            {
              icon: 'quill' as const,
              href: `/tai-khoan/be/${memorial.id}/cau-chuyen`,
              title: 'Câu chuyện',
              note: memorial.bio ? 'Đã có bài viết' : 'Chưa viết gì — có nút nhờ AI viết giúp',
            },
            {
              icon: 'palette' as const,
              href: `/tai-khoan/be/${memorial.id}/giao-dien`,
              title: 'Giao diện',
              note: `Đang dùng: ${themeName}`,
            },
            {
              icon: 'book' as const,
              href: `/tai-khoan/be/${memorial.id}/luu-but`,
              title: 'Sổ lưu bút',
              note: 'Duyệt hoặc ẩn lời nhắn của người ghé thăm',
              badge: pendingCount > 0 ? `${pendingCount} chờ duyệt` : null,
            },
          ].map((item) => (
            <li class="border-t border-cream-300 last:border-b">
              <a href={item.href} class="group flex items-center gap-4 py-4">
                <span class="shrink-0 text-clay-500">
                  <Icon name={item.icon} size={20} />
                </span>
                <span class="min-w-0 flex-1">
                  <span class="flex flex-wrap items-center gap-2">
                    <span class="font-medium text-ink-900">{item.title}</span>
                    {item.badge && <span class="badge bg-clay-500 text-white">{item.badge}</span>}
                  </span>
                  <span class="mt-0.5 block text-sm text-ink-500">{item.note}</span>
                </span>
                <span class="shrink-0 text-cream-400 transition group-hover:translate-x-0.5 group-hover:text-clay-500">
                  <Icon name="chevron-right" size={18} />
                </span>
              </a>
            </li>
          ))
        }
      </ul>

      <!-- Vườn tưởng niệm chung -->
      {
        !living && (
          <div class="mt-10 rounded-2xl border border-cream-300 p-5">
            <div class="flex flex-wrap items-start justify-between gap-4">
              <div class="min-w-0">
                <p class="font-medium text-ink-900">Vườn tưởng niệm chung</p>
                <p class="mt-1.5 text-sm text-ink-500">
                  {memorial.showInGarden
                    ? `${memorial.petName} đang hiện ở trang /vuon-tuong-niem để người lạ ghé thăm và thắp nến.`
                    : 'Trang của bé đang riêng tư — chỉ ai có link hoặc quét mã QR mới xem được. Bật lên nếu bạn muốn chia sẻ bé với mọi người.'}
                </p>
                {!memorial.isPublished && (
                  <p class="mt-2 text-sm text-ink-500">
                    Trang còn ở dạng nháp nên chưa hiện trong vườn dù có bật.
                  </p>
                )}
              </div>
              <form method="POST" class="shrink-0">
                <input type="hidden" name="intent" value="garden" />
                <input type="hidden" name="show" value={memorial.showInGarden ? '0' : '1'} />
                <button type="submit" class="btn-secondary">
                  {memorial.showInGarden ? 'Gỡ khỏi vườn' : 'Hiện trong vườn'}
                </button>
              </form>
            </div>
          </div>
        )
      }

      <!-- Chuyển sổ ký ức sang trang tưởng niệm -->
      {
        living && (
          <div class="mt-10 rounded-2xl border border-cream-300 bg-cream-100/60 p-5">
            <p class="font-medium text-ink-900">Nếu {memorial.petName} đã rời đi</p>
            <p class="mt-1.5 text-sm text-ink-500">
              Chuyển trang này thành trang tưởng niệm. Toàn bộ ảnh, câu chuyện và lời lưu bút giữ
              nguyên; trang sẽ có thêm mốc 49 ngày, 100 ngày và ngày giỗ theo âm lịch.
            </p>
            <a
              href={`/tai-khoan/be/${memorial.id}/chuyen-tuong-niem`}
              class="btn-secondary mt-4 inline-flex"
            >
              Chuyển sang trang tưởng niệm
            </a>
          </div>
        )
      }

      <!-- Xoá trang -->
      <details class="mt-10 border-t border-cream-300 pt-6">
        <summary class="cursor-pointer text-sm font-medium text-red-700">
          Xoá trang kỷ niệm này
        </summary>
        <p class="measure mt-3 text-sm text-ink-500">
          Xoá là mất hẳn: ảnh, câu chuyện, lời lưu bút, số lượt ghé thăm. Không lấy lại được.
        </p>
        <form method="POST" class="mt-4 flex flex-wrap items-end gap-3">
          <input type="hidden" name="intent" value="delete" />
          <div>
            <label class="label" for="confirmName">Nhập “{memorial.petName}” để xác nhận</label>
            <input class="input" id="confirmName" name="confirmName" autocomplete="off" />
          </div>
          <button type="submit" class="btn-secondary border-red-200 text-red-700 hover:bg-red-50">
            Xoá vĩnh viễn
          </button>
        </form>
      </details>
    </div>

    <!-- Cột phải -->
    <div class="space-y-10">
      <section>
        <h2 class="eyebrow">Gói của trang này</h2>
        {
          memorial.isPremium ? (
            <p class="mt-3 text-sm leading-relaxed text-ink-500">
              Premium — đã trả một lần, dùng trọn đời. Bạn có tất cả giao diện, ảnh không giới hạn,
              email nhắc ngày tưởng niệm và tải thẻ QR in sẵn.
            </p>
          ) : (
            <>
              <p class="mt-3 text-sm leading-relaxed text-ink-500">
                Đang dùng gói miễn phí: {limits.photos} ảnh, một giao diện, có dòng thương hiệu ở
                chân trang, chưa có email nhắc ngày giỗ.
              </p>
              <a href={`/tai-khoan/be/${memorial.id}/nang-cap`} class="btn-primary mt-4 w-full">
                Nâng cấp — {formatVnd(amountToCharge('premium'))}
              </a>
            </>
          )
        }
      </section>

      <section class="border-t border-cream-300 pt-8">
        <h2 class="eyebrow">Nhắc ngày tưởng niệm</h2>
        {
          !memorial.deathDate ? (
            <p class="mt-3 text-sm text-ink-500">
              Cần có ngày bé rời đi để tính ngày 49 và ngày giỗ.{' '}
              <a class="link-quiet" href={`/tai-khoan/be/${memorial.id}/thong-tin`}>
                Thêm ngày
              </a>
            </p>
          ) : (
            <>
              {nextMilestone && (
                <div class="mt-3 flex gap-3">
                  <span class="mt-0.5 shrink-0 text-clay-500">
                    <Icon name="lotus" size={18} />
                  </span>
                  <div>
                    <p class="text-sm font-medium text-ink-900">{nextMilestone.label}</p>
                    <p class="mt-0.5 text-sm text-ink-500 tabular-nums">
                      {formatDate(nextMilestone.date)}
                      {nextMilestone.lunarText && ` · ${nextMilestone.lunarText}`}
                    </p>
                  </div>
                </div>
              )}
              {memorial.isPremium ? (
                <form method="POST" class="mt-4">
                  <input type="hidden" name="intent" value="reminders" />
                  <input type="hidden" name="enabled" value={remindersOn ? '0' : '1'} />
                  <button type="submit" class="btn-secondary w-full">
                    {remindersOn ? 'Tắt email nhắc' : 'Bật email nhắc'}
                  </button>
                </form>
              ) : (
                <p class="mt-3 text-sm text-ink-500">Email nhắc là quyền lợi của gói Premium.</p>
              )}
            </>
          )
        }
      </section>

      <section class="border-t border-cream-300 pt-8">
        <h2 class="eyebrow">Mã QR</h2>
        <div class="mt-4 border border-cream-300 bg-white p-3">
          <img
            src={`/be/${memorial.slug}/qr.svg`}
            alt={`Mã QR trang kỷ niệm của ${memorial.petName}`}
            class="mx-auto h-36 w-36"
            width="144"
            height="144"
          />
        </div>
        <p class="mt-3 text-xs break-all text-ink-500">{publicUrl}</p>

        <div class="mt-4 space-y-2">
          <button type="button" class="btn-secondary w-full" data-copy-link data-url={publicUrl}>
            <Icon name="link" size={16} />
            Copy đường dẫn
          </button>
          {
            memorial.isPremium ? (
              <>
                <a href={`/be/${memorial.slug}/qr.svg?card=1&download=1`} class="btn-secondary w-full" download>
                  Tải thẻ QR in sẵn (SVG)
                </a>
                <button type="button" class="btn-secondary w-full" data-download-png data-slug={memorial.slug}>
                  Tải mã QR PNG 2048px
                </button>
              </>
            ) : (
              <p class="hint">Tải file QR chất lượng cao để tự in là quyền lợi gói Premium.</p>
            )
          }
        </div>
      </section>
    </div>
  </div>
</AppLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-link]').forEach((button) => {
    button.addEventListener('click', async () => {
      const url = button.dataset.url!;
      try {
        await navigator.clipboard.writeText(url);
        const original = button.textContent;
        button.textContent = 'Đã copy ✓';
        setTimeout(() => (button.textContent = original), 2000);
      } catch {
        window.prompt('Copy đường dẫn này:', url);
      }
    });
  });

  /** Chuyển SVG mã QR thành PNG cỡ lớn ngay trên máy người dùng. */
  document.querySelectorAll<HTMLButtonElement>('[data-download-png]').forEach((button) => {
    button.addEventListener('click', async () => {
      const slug = button.dataset.slug!;
      const original = button.textContent;
      button.disabled = true;
      button.textContent = 'Đang tạo…';
      try {
        const response = await fetch(`/be/${slug}/qr.svg`);
        const svgText = await response.text();
        const blob = new Blob([svgText], { type: 'image/svg+xml' });
        const blobUrl = URL.createObjectURL(blob);

        const image = new Image();
        image.width = 2048;
        image.height = 2048;
        await new Promise((resolve, reject) => {
          image.onload = resolve;
          image.onerror = reject;
          image.src = blobUrl;
        });

        const canvas = document.createElement('canvas');
        canvas.width = 2048;
        canvas.height = 2048;
        const context = canvas.getContext('2d')!;
        context.fillStyle = '#ffffff';
        context.fillRect(0, 0, 2048, 2048);
        context.imageSmoothingEnabled = false;
        context.drawImage(image, 0, 0, 2048, 2048);
        URL.revokeObjectURL(blobUrl);

        const link = document.createElement('a');
        link.download = `${slug}-qr-2048.png`;
        link.href = canvas.toDataURL('image/png');
        link.click();
      } catch {
        alert('Chưa tạo được file PNG. Bạn thử tải bản SVG nhé.');
      } finally {
        button.disabled = false;
        button.textContent = original;
      }
    });
  });
</script>
