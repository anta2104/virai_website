---
import AppLayout from '../../layouts/AppLayout.astro';
import { currentUser } from '../../lib/guards';
import {
  listOrdersOfUser,
  ORDER_STATUS_LABEL,
  ORDER_TYPE_LABEL,
  parseShippingInfo,
} from '../../lib/orders';
import { listMemorialsOfUser } from '../../lib/memorials';
import { formatVnd } from '../../lib/plans';
import { formatDateTime } from '../../lib/format';
import { env } from '../../lib/env';

const user = currentUser(Astro.locals);
const orders = await listOrdersOfUser(user.id);
const memorials = await listMemorialsOfUser(env.DB, user.id);
const nameById = new Map(memorials.map((memorial) => [memorial.id, memorial.petName]));
---

<AppLayout title="Đơn hàng" wide>
  {
    orders.length === 0 ? (
      <div class="card p-8 text-center">
        <p class="text-sm text-ink-500">Bạn chưa có đơn hàng nào.</p>
        <a href="/bang-gia" class="btn-secondary mt-5">Xem bảng giá</a>
      </div>
    ) : (
      <ul class="space-y-4">
        {orders.map((order) => {
          const shipping = parseShippingInfo(order.shippingInfo);
          const isPending = order.status === 'pending';
          return (
            <li class="card p-5">
              <div class="flex flex-wrap items-start justify-between gap-4">
                <div>
                  <p class="font-medium text-ink-900">{ORDER_TYPE_LABEL[order.type] ?? order.type}</p>
                  {order.memorialId && nameById.has(order.memorialId) && (
                    <p class="text-sm text-ink-500">Cho bé {nameById.get(order.memorialId)}</p>
                  )}
                  <p class="mt-1 text-xs text-ink-500">
                    Mã: <code class="font-mono">{order.paymentCode}</code> · tạo lúc{' '}
                    {formatDateTime(order.createdAt)}
                    {order.paidAt && ` · thanh toán lúc ${formatDateTime(order.paidAt)}`}
                  </p>
                  {shipping && (
                    <p class="mt-1 text-xs text-ink-500">
                      Gửi tới {shipping.fullName} — {shipping.address}
                    </p>
                  )}
                </div>
                <div class="text-right">
                  <p class="font-semibold text-ink-900">{formatVnd(order.amount)}</p>
                  <span
                    class:list={[
                      'badge mt-1',
                      order.status === 'pending' && 'bg-cream-200 text-ink-500',
                      order.status === 'paid' && 'bg-sage-100 text-sage-700',
                      order.status === 'shipped' && 'bg-clay-100 text-clay-700',
                      order.status === 'done' && 'bg-sage-100 text-sage-700',
                      order.status === 'cancelled' && 'bg-red-50 text-red-700',
                    ]}
                  >
                    {ORDER_STATUS_LABEL[order.status] ?? order.status}
                  </span>
                  {isPending && (
                    <a href={`/tai-khoan/thanh-toan/${order.id}`} class="btn-primary btn-sm mt-3 block">
                      Thanh toán
                    </a>
                  )}
                </div>
              </div>
            </li>
          );
        })}
      </ul>
    )
  }
</AppLayout>
