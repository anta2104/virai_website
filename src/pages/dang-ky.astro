---
import SiteLayout from '../layouts/SiteLayout.astro';
import {
  createSession,
  registerUser,
  setSessionCookie,
  validateEmail,
  validatePassword,
} from '../lib/auth';
import { getDb } from '../lib/db';
import { googleAuthConfigured } from '../lib/google-auth';
import { env } from '../lib/env';


if (Astro.locals.user) {
  return Astro.redirect('/tai-khoan');
}

let error: string | null = null;
let values = { name: '', email: '' };

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const name = String(form.get('name') ?? '').trim();
  const email = String(form.get('email') ?? '').trim();
  const password = String(form.get('password') ?? '');
  values = { name, email };

  error =
    (!name ? 'Vui lòng cho biết tên của bạn.' : null) ??
    validateEmail(email) ??
    validatePassword(password);

  if (!error) {
    const result = await registerUser(env.DB, {
      email,
      password,
      name,
      adminEmail: env.ADMIN_EMAIL,
    });
    if (!result.ok || !result.user) {
      error = result.error ?? 'Không tạo được tài khoản, bạn thử lại nhé.';
    } else {
      const session = await createSession(getDb(env.DB), result.user.id, env.SESSION_SECRET);
      setSessionCookie(Astro.cookies, session.cookieValue, session.expiresAt, Astro.url.protocol === 'https:');
      return Astro.redirect('/tai-khoan/tao-trang');
    }
  }
}
---

<SiteLayout title="Tạo tài khoản" description="Tạo tài khoản miễn phí để lập trang kỷ niệm cho bé.">
  <section class="px-4 py-16 sm:px-6 lg:py-24">
    <div class="mx-auto w-full max-w-sm">
      <div>
        <p class="eyebrow">Bắt đầu</p>
        <h1 class="mt-3 font-serif text-3xl font-semibold">Tạo tài khoản</h1>
        <p class="mt-3 text-ink-500">
          Miễn phí, không cần thẻ ngân hàng. Bạn sẽ tạo được trang kỷ niệm đầu tiên ngay sau bước
          này.
        </p>

        {error && <p class="alert-error mt-6">{error}</p>}

        {
          googleAuthConfigured(env) && (
            <>
              <a
                href="/api/auth/google?next=/tai-khoan/tao-trang"
                class="btn-secondary mt-6 flex w-full items-center justify-center gap-2.5"
              >
                <svg viewBox="0 0 18 18" width="18" height="18" aria-hidden="true">
                  <path
                    fill="#4285F4"
                    d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84a4.14 4.14 0 0 1-1.8 2.72v2.26h2.92c1.7-1.57 2.68-3.88 2.68-6.62Z"
                  />
                  <path
                    fill="#34A853"
                    d="M9 18c2.43 0 4.47-.8 5.96-2.18l-2.92-2.26c-.8.54-1.84.86-3.04.86-2.34 0-4.32-1.58-5.03-3.7H.96v2.33A9 9 0 0 0 9 18Z"
                  />
                  <path
                    fill="#FBBC05"
                    d="M3.97 10.72a5.4 5.4 0 0 1 0-3.44V4.95H.96a9 9 0 0 0 0 8.1l3.01-2.33Z"
                  />
                  <path
                    fill="#EA4335"
                    d="M9 3.58c1.32 0 2.5.46 3.44 1.35l2.58-2.58C13.46.9 11.43 0 9 0A9 9 0 0 0 .96 4.95l3.01 2.33C4.68 5.16 6.66 3.58 9 3.58Z"
                  />
                </svg>
                Tiếp tục với Google
              </a>

              <div class="mt-6 flex items-center gap-3 text-sm text-ink-500">
                <span class="h-px flex-1 bg-cream-300" />
                hoặc
                <span class="h-px flex-1 bg-cream-300" />
              </div>
            </>
          )
        }

        <form method="POST" class="mt-6 space-y-4">
          <div>
            <label class="label" for="name">Tên của bạn</label>
            <input class="input" id="name" name="name" required maxlength="80" value={values.name} autocomplete="name" />
          </div>
          <div>
            <label class="label" for="email">Email</label>
            <input
              class="input"
              id="email"
              name="email"
              type="email"
              required
              value={values.email}
              autocomplete="email"
            />
            <p class="hint">Dùng để đăng nhập và nhận email nhắc ngày tưởng niệm.</p>
          </div>
          <div>
            <label class="label" for="password">Mật khẩu</label>
            <input
              class="input"
              id="password"
              name="password"
              type="password"
              required
              minlength="8"
              autocomplete="new-password"
            />
            <p class="hint">Ít nhất 8 ký tự.</p>
          </div>
          <button type="submit" class="btn-primary w-full">Tạo tài khoản</button>
        </form>

        <p class="mt-8 border-t border-cream-300 pt-6 text-sm text-ink-500">
          Đã có tài khoản? <a class="link-quiet font-medium" href="/dang-nhap">Đăng nhập</a>
        </p>
      </div>
    </div>
  </section>
</SiteLayout>
