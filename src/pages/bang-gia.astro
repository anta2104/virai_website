---
import SiteLayout from '../layouts/SiteLayout.astro';
import PricingTable from '../components/PricingTable.astro';
import { ANALYSIS_FREE_TOTAL, CREDIT_PACKS, STUDIO_COSTS, WELCOME_CREDITS, formatVnd, priceView, isPromoActive, PROMO } from '../lib/plans';
import { site } from '../lib/site';

const ctaHref = Astro.locals.user ? '/tai-khoan' : '/dang-ky';
const creditsHref = Astro.locals.user ? '/tai-khoan/tin-chi' : '/dang-ky?next=%2Ftai-khoan%2Ftin-chi';
const premium = priceView('premium');
const combo = priceView('physicalCombo');

/** Giá trả một lần, không phải thuê bao — nên dùng Offer chứ không phải Subscription. */
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    ...CREDIT_PACKS.map((pack) => ({
      '@type': 'Product',
      name: `${site.name} ${pack.label} ${pack.credits} tín chỉ`,
      description: `${pack.credits} tín chỉ dùng cho phân tích kênh TikTok (${STUDIO_COSTS.tiktokAnalysis} tín chỉ/lượt) và ảnh người mẫu ảo (${STUDIO_COSTS.photoshootImage} tín chỉ/ảnh).`,
      brand: { '@type': 'Brand', name: site.name },
      offers: {
        '@type': 'Offer',
        price: pack.price,
        priceCurrency: 'VND',
        availability: 'https://schema.org/InStock',
        url: new URL('/bang-gia', site.url).href,
      },
    })),
    {
      '@type': 'Product',
      name: `${site.name} Premium`,
      description:
        'Trang kỷ niệm không giới hạn ảnh, đủ giao diện, email nhắc ngày tưởng niệm theo âm lịch, ẩn thương hiệu, tải mã QR chất lượng cao.',
      brand: { '@type': 'Brand', name: site.name },
      offers: {
        '@type': 'Offer',
        price: premium.price,
        priceCurrency: 'VND',
        availability: 'https://schema.org/InStock',
        url: new URL('/bang-gia', site.url).href,
      },
    },
    {
      '@type': 'Product',
      name: `${site.name} Combo thẻ QR`,
      description:
        'Gói Premium kèm thẻ kim loại hoặc gỗ khắc sẵn mã QR của bé, gửi tận nơi.',
      brand: { '@type': 'Brand', name: site.name },
      offers: {
        '@type': 'Offer',
        price: combo.price,
        priceCurrency: 'VND',
        availability: 'https://schema.org/InStock',
        url: new URL('/bang-gia', site.url).href,
      },
    },
  ],
};
---

<SiteLayout
  title="Bảng giá"
  description={`Lượt phân tích đầu miễn phí, sau đó ${STUDIO_COSTS.tiktokAnalysis} tín chỉ mỗi lượt. Gói tín chỉ từ ${formatVnd(CREDIT_PACKS[0].price)}, dùng cho cả phân tích và ảnh người mẫu ảo.`}
  jsonLd={jsonLd}
>
  <section class="section">
    <div class="container-page">
      <div class="text-center">
        <h1 class="font-serif text-4xl font-semibold">Bảng giá</h1>
        <p class="mx-auto mt-4 max-w-2xl text-ink-500">
          Phân tích kênh TikTok: {ANALYSIS_FREE_TOTAL} lượt đầu miễn phí, sau đó {STUDIO_COSTS.tiktokAnalysis} tín chỉ mỗi lượt.
          Ảnh người mẫu ảo: {STUDIO_COSTS.photoshootImage} tín chỉ mỗi ảnh. Cùng một loại tín chỉ, nạp bao nhiêu dùng bấy nhiêu, không có phí thuê bao.
        </p>
      </div>

      <div class="mt-14">
        <p class="eyebrow text-center">Phân tích TikTok và studio người mẫu ảo</p>
        <h2 class="mt-3 text-center font-serif text-2xl font-semibold">Gói tín chỉ</h2>
        <p class="mx-auto mt-3 max-w-xl text-center text-sm text-ink-500">
          Một lượt phân tích kênh trừ {STUDIO_COSTS.tiktokAnalysis} tín chỉ, một ảnh người mẫu trừ {STUDIO_COSTS.photoshootImage} tín chỉ.
          Tài khoản mới được {ANALYSIS_FREE_TOTAL} lượt phân tích miễn phí và {WELCOME_CREDITS} tín chỉ để thử. Lỗi thì hoàn lại tín chỉ.
        </p>
        <div class="mt-8 grid gap-5 md:grid-cols-3">
          {
            CREDIT_PACKS.map((pack, index) => (
              <div class:list={['card flex flex-col p-6', index === 1 && 'border-clay-400 ring-1 ring-clay-300']}>
                <p class="eyebrow">{pack.label}</p>
                <p class="mt-3 font-serif text-3xl font-semibold text-ink-900">{pack.credits} tín chỉ</p>
                <p class="mt-1 text-sm text-ink-500">
                  {formatVnd(pack.price)} · {Math.floor(pack.credits / STUDIO_COSTS.tiktokAnalysis)} lượt phân tích hoặc {pack.credits} ảnh
                </p>
                <a href={creditsHref} class:list={[index === 1 ? 'btn-primary' : 'btn-secondary', 'mt-6']}>
                  Nạp gói này
                </a>
              </div>
            ))
          }
        </div>
      </div>

      <div class="rule mt-20 pt-14">
        <p class="eyebrow text-center">Trang tưởng niệm thú cưng</p>
        <h2 class="mt-3 text-center font-serif text-2xl font-semibold">Gói Premium và thẻ QR</h2>
        <p class="mx-auto mt-3 max-w-xl text-center text-sm text-ink-500">
          Không có phí duy trì hằng năm. Premium trả một lần cho mỗi bé và trang được giữ trọn đời.
        </p>
      </div>

      {
        isPromoActive() && (
          <p class="mx-auto mt-8 flex max-w-xl flex-wrap items-center justify-center gap-x-2 gap-y-1 rounded-full border border-clay-200 bg-clay-50 px-5 py-2.5 text-sm text-clay-800">
            <strong class="font-semibold">{PROMO.label}:</strong>
            giảm {PROMO.percent}% gói Premium, đến hết {PROMO.endsAtLabel}
          </p>
        )
      }

      <div class="mt-10">
        <PricingTable ctaHref={ctaHref} />
      </div>
    </div>
  </section>

  <section class="section bg-cream-100">
    <div class="container-narrow">
      <h2 class="font-serif text-2xl font-semibold">Thanh toán thế nào?</h2>
      <ol class="mt-6 space-y-5">
        <li class="card flex gap-4 p-5">
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-clay-500 text-sm font-semibold text-white">1</span>
          <div>
            <p class="font-medium text-ink-900">Bấm nạp tín chỉ hoặc nâng cấp trong tài khoản</p>
            <p class="mt-1 text-sm text-ink-500">
              Hệ thống tạo một đơn với nội dung chuyển khoản riêng, ví dụ <code class="rounded bg-cream-200 px-1.5 py-0.5 text-xs">VRM7K2QPX4</code>.
            </p>
          </div>
        </li>
        <li class="card flex gap-4 p-5">
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-clay-500 text-sm font-semibold text-white">2</span>
          <div>
            <p class="font-medium text-ink-900">Mở app ngân hàng, quét mã VietQR</p>
            <p class="mt-1 text-sm text-ink-500">
              Số tiền và nội dung chuyển khoản đã điền sẵn trong mã. Bạn chỉ cần xác nhận.
            </p>
          </div>
        </li>
        <li class="card flex gap-4 p-5">
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-clay-500 text-sm font-semibold text-white">3</span>
          <div>
            <p class="font-medium text-ink-900">Tín chỉ tự cộng, trang tự lên Premium</p>
            <p class="mt-1 text-sm text-ink-500">
              Thường trong vòng 1–2 phút sau khi tiền vào. Nếu quá 15 phút chưa thấy, bạn nhắn cho
              chúng tôi kèm mã đơn để xác nhận tay.
            </p>
          </div>
        </li>
      </ol>

      <div class="alert-info mt-8">
        <p class="font-medium">Về combo thẻ QR vật lý</p>
        <p class="mt-1">
          Sau khi thanh toán, bạn điền địa chỉ nhận hàng và chọn chất liệu (kim loại hoặc gỗ). Chúng
          tôi khắc mã QR, tên và ngày tháng của bé rồi gửi tới bạn. Thời gian khắc và giao thường
          5–10 ngày.
        </p>
      </div>
    </div>
  </section>
</SiteLayout>
