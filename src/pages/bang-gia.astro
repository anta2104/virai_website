---
import SiteLayout from '../layouts/SiteLayout.astro';
import PricingTable from '../components/PricingTable.astro';
import { formatVnd, priceView, isPromoActive, PROMO } from '../lib/plans';
import { site } from '../lib/site';

const ctaHref = Astro.locals.user ? '/tai-khoan' : '/dang-ky';
const premium = priceView('premium');
const combo = priceView('physicalCombo');

/** Giá trả một lần, không phải thuê bao — nên dùng Offer chứ không phải Subscription. */
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Product',
      name: `${site.name} Premium`,
      description:
        'Trang kỷ niệm không giới hạn ảnh, đủ giao diện, email nhắc ngày tưởng niệm theo âm lịch, ẩn thương hiệu, tải mã QR chất lượng cao.',
      brand: { '@type': 'Brand', name: site.name },
      offers: {
        '@type': 'Offer',
        price: premium.price,
        priceCurrency: 'VND',
        availability: 'https://schema.org/InStock',
        url: new URL('/bang-gia', site.url).href,
      },
    },
    {
      '@type': 'Product',
      name: `${site.name} Combo thẻ QR`,
      description:
        'Gói Premium kèm thẻ kim loại hoặc gỗ khắc sẵn mã QR của bé, gửi tận nơi.',
      brand: { '@type': 'Brand', name: site.name },
      offers: {
        '@type': 'Offer',
        price: combo.price,
        priceCurrency: 'VND',
        availability: 'https://schema.org/InStock',
        url: new URL('/bang-gia', site.url).href,
      },
    },
  ],
};
---

<SiteLayout
  title="Bảng giá"
  description={`Miễn phí để bắt đầu. Premium ${formatVnd(premium.price)} trả một lần cho mỗi bé. Combo thẻ QR khắc sẵn từ ${formatVnd(combo.price)}.`}
  jsonLd={jsonLd}
>
  <section class="section">
    <div class="container-page">
      <div class="text-center">
        <h1 class="font-serif text-4xl font-semibold">Bảng giá</h1>
        <p class="mx-auto mt-4 max-w-2xl text-ink-500">
          Không có phí duy trì hằng năm. Gói Premium trả một lần cho mỗi bé và trang được giữ trọn
          đời.
        </p>
      </div>

      {
        isPromoActive() && (
          <p class="mx-auto mt-8 flex max-w-xl flex-wrap items-center justify-center gap-x-2 gap-y-1 rounded-full border border-clay-200 bg-clay-50 px-5 py-2.5 text-sm text-clay-800">
            <strong class="font-semibold">{PROMO.label}:</strong>
            giảm {PROMO.percent}% gói Premium, đến hết {PROMO.endsAtLabel}
          </p>
        )
      }

      <div class="mt-14">
        <PricingTable ctaHref={ctaHref} />
      </div>
    </div>
  </section>

  <section class="section bg-cream-100">
    <div class="container-narrow">
      <h2 class="font-serif text-2xl font-semibold">Thanh toán thế nào?</h2>
      <ol class="mt-6 space-y-5">
        <li class="card flex gap-4 p-5">
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-clay-500 text-sm font-semibold text-white">1</span>
          <div>
            <p class="font-medium text-ink-900">Bấm nâng cấp trong trang quản lý của bé</p>
            <p class="mt-1 text-sm text-ink-500">
              Hệ thống tạo một đơn với nội dung chuyển khoản riêng, ví dụ <code class="rounded bg-cream-200 px-1.5 py-0.5 text-xs">VRM7K2QPX4</code>.
            </p>
          </div>
        </li>
        <li class="card flex gap-4 p-5">
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-clay-500 text-sm font-semibold text-white">2</span>
          <div>
            <p class="font-medium text-ink-900">Mở app ngân hàng, quét mã VietQR</p>
            <p class="mt-1 text-sm text-ink-500">
              Số tiền và nội dung chuyển khoản đã điền sẵn trong mã. Bạn chỉ cần xác nhận.
            </p>
          </div>
        </li>
        <li class="card flex gap-4 p-5">
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-clay-500 text-sm font-semibold text-white">3</span>
          <div>
            <p class="font-medium text-ink-900">Trang tự lên Premium</p>
            <p class="mt-1 text-sm text-ink-500">
              Thường trong vòng 1–2 phút sau khi tiền vào. Nếu quá 15 phút chưa thấy, bạn nhắn cho
              chúng tôi kèm mã đơn để xác nhận tay.
            </p>
          </div>
        </li>
      </ol>

      <div class="alert-info mt-8">
        <p class="font-medium">Về combo thẻ QR vật lý</p>
        <p class="mt-1">
          Sau khi thanh toán, bạn điền địa chỉ nhận hàng và chọn chất liệu (kim loại hoặc gỗ). Chúng
          tôi khắc mã QR, tên và ngày tháng của bé rồi gửi tới bạn. Thời gian khắc và giao thường
          5–10 ngày.
        </p>
      </div>
    </div>
  </section>
</SiteLayout>
