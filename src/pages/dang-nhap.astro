---
import SiteLayout from '../layouts/SiteLayout.astro';
import { createSession, loginUser, setSessionCookie } from '../lib/auth';
import { getDb } from '../lib/db';
import { googleAuthConfigured, isGoogleOnlyEmail } from '../lib/google-auth';
import { env } from '../lib/env';


/** Chỉ cho phép chuyển tiếp tới đường dẫn nội bộ để tránh open redirect. */
function safeNext(value: string | null): string {
  if (!value) return '/tai-khoan';
  return value.startsWith('/') && !value.startsWith('//') ? value : '/tai-khoan';
}

const next = safeNext(Astro.url.searchParams.get('next'));

if (Astro.locals.user) {
  return Astro.redirect(next);
}

let error: string | null = null;
let email = '';

/** Vừa đặt lại mật khẩu xong thì chào một câu cho người ta biết là đã ăn. */
const justReset = Astro.url.searchParams.get('dat-lai') === 'xong';

const googleReady = googleAuthConfigured(env);
/** Email này là tài khoản chỉ đăng nhập bằng Google */
let googleOnlyHint = false;

const GOOGLE_ERRORS: Record<string, string> = {
  loi: 'Đăng nhập bằng Google chưa xong. Bạn thử lại nhé.',
  'chua-cau-hinh': 'Đăng nhập bằng Google chưa được bật. Bạn dùng email và mật khẩu nhé.',
  'email-chua-xac-thuc':
    'Email của tài khoản Google này chưa được xác thực nên chúng tôi chưa dùng để đăng nhập được.',
};
const googleError = GOOGLE_ERRORS[Astro.url.searchParams.get('google') ?? ''] ?? null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  email = String(form.get('email') ?? '').trim();
  const password = String(form.get('password') ?? '');
  const formNext = safeNext(String(form.get('next') ?? ''));

  const result = await loginUser(env.DB, { email, password });
  if (!result.ok || !result.user) {
    error = result.error ?? 'Không đăng nhập được.';
    // Tài khoản sinh ra từ Google thì không có mật khẩu — chỉ báo "sai mật
    // khẩu" là để người ta thử đi thử lại mãi mà không hiểu vì sao.
    if (googleReady && (await isGoogleOnlyEmail(env.DB, email))) {
      googleOnlyHint = true;
      error = null;
    }
  } else {
    const session = await createSession(getDb(env.DB), result.user.id, env.SESSION_SECRET);
    setSessionCookie(Astro.cookies, session.cookieValue, session.expiresAt, Astro.url.protocol === 'https:');
    return Astro.redirect(formNext);
  }
}
---

<SiteLayout title="Đăng nhập" noindex>
  <section class="px-4 py-16 sm:px-6 lg:py-24">
    <div class="mx-auto w-full max-w-sm">
      <div>
        <p class="eyebrow">Chào bạn quay lại</p>
        <h1 class="mt-3 font-serif text-3xl font-semibold">Đăng nhập</h1>

        {justReset && !error && (
          <p class="alert-success mt-6">
            Đã đổi mật khẩu xong. Bạn đăng nhập lại bằng mật khẩu mới nhé.
          </p>
        )}
        {googleError && <p class="alert-error mt-6">{googleError}</p>}
        {error && <p class="alert-error mt-6">{error}</p>}

        {
          googleOnlyHint && (
            <div class="alert-info mt-6">
              <p class="font-medium">Tài khoản này đăng nhập bằng Google.</p>
              <p class="mt-1.5 text-sm">
                Bạn bấm "Tiếp tục với Google" bên dưới. Hoặc nếu muốn dùng mật khẩu, hãy{' '}
                <a class="link-quiet font-medium" href="/quen-mat-khau">
                  đặt một mật khẩu mới
                </a>{' '}
                cho tài khoản.
              </p>
            </div>
          )
        }

        {
          googleReady && (
            <>
              <a
                href={`/api/auth/google?next=${encodeURIComponent(next)}`}
                class="btn-secondary mt-6 flex w-full items-center justify-center gap-2.5"
              >
                <svg viewBox="0 0 18 18" width="18" height="18" aria-hidden="true">
                  <path
                    fill="#4285F4"
                    d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84a4.14 4.14 0 0 1-1.8 2.72v2.26h2.92c1.7-1.57 2.68-3.88 2.68-6.62Z"
                  />
                  <path
                    fill="#34A853"
                    d="M9 18c2.43 0 4.47-.8 5.96-2.18l-2.92-2.26c-.8.54-1.84.86-3.04.86-2.34 0-4.32-1.58-5.03-3.7H.96v2.33A9 9 0 0 0 9 18Z"
                  />
                  <path
                    fill="#FBBC05"
                    d="M3.97 10.72a5.4 5.4 0 0 1 0-3.44V4.95H.96a9 9 0 0 0 0 8.1l3.01-2.33Z"
                  />
                  <path
                    fill="#EA4335"
                    d="M9 3.58c1.32 0 2.5.46 3.44 1.35l2.58-2.58C13.46.9 11.43 0 9 0A9 9 0 0 0 .96 4.95l3.01 2.33C4.68 5.16 6.66 3.58 9 3.58Z"
                  />
                </svg>
                Tiếp tục với Google
              </a>

              <div class="mt-6 flex items-center gap-3 text-sm text-ink-400">
                <span class="h-px flex-1 bg-cream-300" />
                hoặc
                <span class="h-px flex-1 bg-cream-300" />
              </div>
            </>
          )
        }

        <form method="POST" class="mt-6 space-y-4">
          <input type="hidden" name="next" value={next} />
          <div>
            <label class="label" for="email">Email</label>
            <input class="input" id="email" name="email" type="email" required value={email} autocomplete="email" />
          </div>
          <div>
            <div class="flex items-baseline justify-between gap-3">
              <label class="label" for="password">Mật khẩu</label>
              <a class="link-quiet text-sm" href="/quen-mat-khau">Quên mật khẩu?</a>
            </div>
            <input
              class="input"
              id="password"
              name="password"
              type="password"
              required
              autocomplete="current-password"
            />
          </div>
          <button type="submit" class="btn-primary w-full">Đăng nhập</button>
        </form>

        <p class="mt-8 border-t border-cream-300 pt-6 text-sm text-ink-500">
          Chưa có tài khoản? <a class="link-quiet font-medium" href="/dang-ky">Tạo miễn phí</a>
        </p>
      </div>
    </div>
  </section>
</SiteLayout>
