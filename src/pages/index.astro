---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import type { IconName } from '../lib/icons';
import { site } from '../lib/site';
import ModelPortrait from '../components/studio/ModelPortrait.astro';
import { listActiveModels } from '../lib/studio/models';
import { ensurePortraits } from '../lib/studio/portraits';
import { CREDIT_PACKS, STUDIO_COSTS, WELCOME_CREDITS, formatVnd } from '../lib/plans';

const user = Astro.locals.user;
const models = await listActiveModels().catch(() => []);
// Người mẫu chưa có ảnh thì production tự sinh ở nền, lần mở sau sẽ thấy
ensurePortraits(models, Astro.locals);
const cheapest = CREDIT_PACKS[0];
const studioHref = user ? '/nguoi-mau-ao/tao' : '/nguoi-mau-ao';

const tiktokPoints: Array<{ icon: IconName; title: string; body: string }> = [
  {
    icon: 'eye',
    title: 'Chỉ số thật của 30 video gần nhất',
    body: 'View, like, bình luận, chia sẻ, lưu. Tỉ lệ lưu và chia sẻ tính riêng vì đó là hai tín hiệu TikTok ưu tiên đẩy.',
  },
  {
    icon: 'clock',
    title: 'Giờ đăng hiệu quả của chính kênh bạn',
    body: 'Không phải khung giờ chung chung trên mạng. Tính từ video của bạn: thứ nào, giờ nào view trung vị cao nhất.',
  },
  {
    icon: 'quill',
    title: 'AI nói vì sao video nổi và nên làm gì tiếp',
    body: 'Nhóm chủ đề đang kéo kênh, xu hướng lên hay xuống, 5 ý tưởng video kế tiếp kèm câu mở đầu.',
  },
];

const steps = [
  {
    title: 'Dán link kênh TikTok',
    body: 'Link hoặc @tên kênh đều được. Hệ thống kéo video gần nhất và tính chỉ số trong vài giây.',
  },
  {
    title: 'Đọc phân tích',
    body: 'Biểu đồ, bảng video, giờ đăng tốt, hashtag hiệu quả và phần AI đọc xu hướng kèm điểm sức khỏe kênh.',
  },
  {
    title: 'Tạo ảnh sản phẩm theo xu hướng',
    body: 'Bấm sang studio, chọn người mẫu ảo, đưa sản phẩm vào. Vài phút sau có ảnh để đăng.',
  },
];

const faqs = [
  {
    q: 'Phân tích kênh có mất phí không?',
    a: `Lượt phân tích đầu tiên miễn phí để bạn xem thử. Từ lượt thứ hai, mỗi lượt ${STUDIO_COSTS.tiktokAnalysis} tín chỉ. Tín chỉ nạp một lần dùng cho cả phân tích lẫn ảnh người mẫu (mỗi ảnh ${STUDIO_COSTS.photoshootImage} tín chỉ), không hết hạn.`,
  },
  {
    q: 'Tôi có phân tích được kênh của người khác không?',
    a: 'Được, miễn là kênh công khai. Dùng để học từ kênh cùng ngách hoặc so với đối thủ.',
  },
  {
    q: 'Người mẫu ảo là ai?',
    a: 'Là nhân vật do AI tạo, không dựa trên người thật. Chúng tôi không nhận ảnh mặt người thật đưa vào studio.',
  },
  {
    q: 'Ảnh sinh ra có đúng sản phẩm của tôi không?',
    a: 'Ở bản hiện tại, người mẫu và bối cảnh giữ nhất quán, còn sản phẩm dựng theo mô tả bằng lời nên có thể lệch chi tiết. Ảnh lỗi được hoàn tín chỉ.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', name: site.name, url: site.url, description: site.description, inLanguage: 'vi' },
    {
      '@type': 'Organization',
      name: site.company,
      url: site.companyUrl,
      email: site.supportEmail,
      logo: new URL('/logo.svg', site.url).href,
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: { '@type': 'Answer', text: faq.a },
      })),
    },
  ],
};
---

<SiteLayout title={`${site.name} — ${site.tagline}`} description={site.description} jsonLd={jsonLd}>
  <!-- Mở đầu -->
  <section class="container-page px-4 pt-14 pb-16 sm:px-6 lg:px-8 lg:pt-24">
    <div class="grid gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
      <div>
        <p class="eyebrow">Cho người bán hàng và creator trên TikTok</p>
        <h1 class="display mt-4">
          Biết video nào đang kéo kênh lên.<br />Có người mẫu chụp sản phẩm ngay.
        </h1>
        <p class="measure mt-6 text-lg text-ink-500">
          Dán link kênh TikTok, AI đọc 30 video gần nhất và nói rõ vì sao video nổi, nên đăng giờ nào,
          làm gì tiếp. Cần ảnh sản phẩm thì thuê một trong năm người mẫu ảo, vài phút là có.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href="/tiktok" class="btn-primary">Phân tích kênh của bạn</a>
          <a href="/nguoi-mau-ao" class="btn-secondary">Xem người mẫu ảo</a>
        </div>
        <p class="mt-4 text-sm text-ink-500">
          Lượt phân tích đầu tiên miễn phí. Tài khoản mới được tặng {WELCOME_CREDITS} tín chỉ để thử studio.
        </p>
      </div>

      <!-- Xem trước kết quả phân tích: để người xem hình dung sản phẩm ngay từ màn đầu -->
      <div class="card overflow-hidden" aria-label="Ví dụ kết quả phân tích kênh">
        <div class="flex items-center justify-between border-b border-cream-200 px-5 py-3">
          <div class="flex items-center gap-2 text-sm">
            <span class="flex h-7 w-7 items-center justify-center rounded-full bg-clay-100 text-xs font-bold text-clay-700">@</span>
            <span class="font-semibold text-ink-900">shop.cua.ban</span>
            <span class="text-ink-500">· 30 video gần nhất</span>
          </div>
          <span class="badge bg-sage-100 text-sage-700">Điểm 78/100</span>
        </div>
        <div class="grid grid-cols-3 divide-x divide-cream-200 border-b border-cream-200">
          <div class="px-5 py-4">
            <p class="text-xs text-ink-500">View trung bình</p>
            <p class="mt-1 text-xl font-bold text-ink-900">42,1K</p>
          </div>
          <div class="px-5 py-4">
            <p class="text-xs text-ink-500">Tỉ lệ lưu</p>
            <p class="mt-1 text-xl font-bold text-ink-900">2,8%</p>
          </div>
          <div class="px-5 py-4">
            <p class="text-xs text-ink-500">Giờ đăng tốt</p>
            <p class="mt-1 text-xl font-bold text-ink-900">20–21h</p>
          </div>
        </div>
        <div class="px-5 pt-4">
          <svg viewBox="0 0 320 90" class="h-auto w-full" aria-hidden="true">
            <defs>
              <linearGradient id="hero-area" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#6d4aff" stop-opacity="0.25" />
                <stop offset="1" stop-color="#6d4aff" stop-opacity="0" />
              </linearGradient>
            </defs>
            <path d="M0 70 L40 62 L80 66 L120 48 L160 54 L200 30 L240 44 L280 18 L320 26 L320 90 L0 90 Z" fill="url(#hero-area)" />
            <path d="M0 70 L40 62 L80 66 L120 48 L160 54 L200 30 L240 44 L280 18 L320 26" fill="none" stroke="#6d4aff" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round" />
            <circle cx="280" cy="18" r="4" fill="#6d4aff" />
            <circle cx="200" cy="30" r="4" fill="#6d4aff" />
          </svg>
        </div>
        <div class="flex gap-3 px-5 pt-3 pb-5">
          <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-clay-500 text-white">
            <Icon name="quill" size={13} />
          </span>
          <p class="text-sm text-ink-700">
            <span class="font-semibold text-ink-900">AI nhận định:</span> hai video nổi nhất đều mở đầu bằng
            câu hỏi và quay cận sản phẩm trong 2 giây đầu. Nên giữ công thức này cho 3 video tới.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Phân tích TikTok: ba điểm chính -->
  <section class="section bg-cream-100">
    <div class="container-page">
      <p class="eyebrow">Phân tích TikTok</p>
      <h2 class="mt-3 max-w-2xl font-serif text-3xl font-semibold">
        Số liệu tính bằng code, nhận định do AI viết. Không trộn lẫn hai thứ.
      </h2>
      <div class="mt-10 grid gap-8 md:grid-cols-3">
        {
          tiktokPoints.map((point) => (
            <div>
              <span class="inline-flex text-clay-500">
                <Icon name={point.icon} size={28} />
              </span>
              <h3 class="mt-3 font-serif text-lg font-semibold">{point.title}</h3>
              <p class="mt-2 text-sm text-ink-500">{point.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Người mẫu ảo -->
  <section class="section">
    <div class="container-page">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow">Studio người mẫu ảo</p>
          <h2 class="mt-3 font-serif text-3xl font-semibold">Năm người mẫu, năm ngách hàng</h2>
          <p class="measure mt-3 text-ink-500">
            Mỗi người có hồ sơ ngoại hình cố định nên gương mặt giữ nhất quán giữa các lần chụp. Bạn chọn
            người hợp với sản phẩm, còn lại để studio lo.
          </p>
        </div>
        <a href="/nguoi-mau-ao" class="btn-secondary">Xem chi tiết từng người</a>
      </div>

      {
        models.length > 0 && (
          <ul class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
            {models.map(({ model, persona, portraitUrl }) => (
              <li class="card overflow-hidden">
                <div class="aspect-[4/5] w-full bg-cream-100">
                  <ModelPortrait slug={model.slug} name={model.name} portraitUrl={portraitUrl} />
                </div>
                <div class="p-4">
                  <p class="font-serif text-lg font-semibold text-ink-900">{model.name}</p>
                  <p class="mt-0.5 text-xs text-ink-500">{persona.niches.slice(0, 2).join(' · ')}</p>
                </div>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>

  <!-- Cách hoạt động -->
  <section class="section bg-cream-100">
    <div class="container-page">
      <p class="eyebrow">Cách hoạt động</p>
      <ol class="mt-8 grid gap-8 md:grid-cols-3">
        {
          steps.map((step, index) => (
            <li class="flex gap-4">
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-clay-500 font-semibold text-white">
                {index + 1}
              </span>
              <div>
                <h3 class="font-serif text-lg font-semibold">{step.title}</h3>
                <p class="mt-2 text-sm text-ink-500">{step.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Giá -->
  <section class="section">
    <div class="container-page">
      <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
        <div>
          <p class="eyebrow">Giá</p>
          <h2 class="mt-3 font-serif text-3xl font-semibold">Lượt đầu miễn phí. Sau đó tính theo tín chỉ.</h2>
          <p class="measure mt-3 text-ink-500">
            Một lượt phân tích kênh {STUDIO_COSTS.tiktokAnalysis} tín chỉ, một ảnh người mẫu {STUDIO_COSTS.photoshootImage} tín chỉ.
            Không thuê bao tháng, tín chỉ không hết hạn. Nạp bằng chuyển khoản VietQR, tự cộng khi tiền vào. Lỗi thì hoàn tín chỉ.
          </p>
          <a href="/bang-gia" class="link-quiet mt-5 inline-block text-sm font-medium">Xem bảng giá đầy đủ</a>
        </div>
        <div class="grid gap-4 sm:grid-cols-3">
          {
            CREDIT_PACKS.map((pack, index) => (
              <div class:list={['card p-5', index === 1 && 'border-clay-400 ring-1 ring-clay-300']}>
                <p class="eyebrow">{pack.label}</p>
                <p class="mt-2 font-serif text-2xl font-semibold text-ink-900">{pack.credits} tín chỉ</p>
                <p class="mt-1 text-sm text-ink-500">{formatVnd(pack.price)}</p>
                <p class="mt-1 text-xs text-ink-500">
                  = {Math.floor(pack.credits / STUDIO_COSTS.tiktokAnalysis)} lượt phân tích hoặc {pack.credits} ảnh
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Hỏi đáp -->
  <section class="section bg-cream-100">
    <div class="container-narrow">
      <p class="eyebrow">Hỏi nhanh</p>
      <dl class="mt-6 divide-y divide-cream-300">
        {
          faqs.map((faq) => (
            <div class="py-5">
              <dt class="font-medium text-ink-900">{faq.q}</dt>
              <dd class="mt-2 text-sm text-ink-500">{faq.a}</dd>
            </div>
          ))
        }
      </dl>
      <p class="mt-8 text-sm text-ink-500">
        Bạn đang tìm trang tưởng niệm thú cưng? Dịch vụ đó vẫn ở đây:
        <a href="/tuong-niem" class="link-quiet">Trang tưởng niệm thú cưng</a>.
      </p>
    </div>
  </section>

  <!-- Kết -->
  <section class="section">
    <div class="container-narrow text-center">
      <h2 class="font-serif text-3xl font-semibold">Dán link kênh của bạn vào xem thử</h2>
      <p class="mx-auto mt-3 max-w-md text-ink-500">Mất chưa tới một phút, không cần thẻ.</p>
      <a href="/tiktok" class="btn-primary mt-7">Phân tích kênh của bạn</a>
    </div>
  </section>
</SiteLayout>
