---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import Icon from '../../../components/Icon.astro';
import StatTile from '../../../components/tiktok/StatTile.astro';
import ViewsChart from '../../../components/tiktok/ViewsChart.astro';
import SlotHeatmap from '../../../components/tiktok/SlotHeatmap.astro';
import TagBars from '../../../components/tiktok/TagBars.astro';
import { notFound } from '../../../lib/guards';
import { formatDateTime } from '../../../lib/format';
import { profileUrl } from '../../../lib/tiktok/handle';
import { bestSlots, compactNumber, percent, WEEKDAY_LABEL } from '../../../lib/tiktok/metrics';
import { TREND_LABEL } from '../../../lib/tiktok/analyze';
import {
  getCreator,
  getOwnedAnalysis,
  listCreatorVideos,
  metricsOf,
  resultOf,
  STATUS_LABEL,
} from '../../../lib/tiktok/service';

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect(`/dang-nhap?next=${encodeURIComponent(Astro.url.pathname)}`);
}

const analysis = await getOwnedAnalysis(Astro.params.id!, user.id);
if (!analysis) return notFound('Không tìm thấy phân tích');

const done = analysis.status === 'done';
const failed = analysis.status === 'failed';
const metrics = done ? metricsOf(analysis) : null;
const result = done ? resultOf(analysis) : null;
const creator = done && analysis.creatorId ? await getCreator(analysis.creatorId) : null;
const videos = done && analysis.creatorId ? await listCreatorVideos(analysis.creatorId) : [];

const topIds = metrics?.topVideos.map((v) => v.tiktokId) ?? [];
const whyById = new Map(result?.topVideos.map((t) => [t.tiktokId, t.why]) ?? []);
const bestHours = metrics ? bestSlots(metrics.byHour) : [];
const bestDays = metrics ? bestSlots(metrics.byWeekday) : [];

const fmtDate = (t: number | null) =>
  t
    ? new Intl.DateTimeFormat('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric', timeZone: 'Asia/Ho_Chi_Minh' }).format(new Date(t * 1000))
    : '';

const scoreTone = (score: number) => (score >= 70 ? 'text-sage-700' : score >= 40 ? 'text-candle' : 'text-red-700');
---

<SiteLayout title={`Phân tích @${analysis.handle}`} noindex>
  <section class="px-4 py-12 sm:px-6 lg:py-16">
    <div class="mx-auto w-full max-w-5xl">
      <a href="/tiktok" class="inline-flex items-center gap-2 text-sm text-ink-500 transition hover:text-clay-700">
        <Icon name="arrow-left" size={16} />
        Phân tích kênh khác
      </a>

      <div class="mt-6 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow">Phân tích TikTok</p>
          <h1 class="mt-2 font-serif text-3xl font-semibold sm:text-4xl">
            <a href={profileUrl(analysis.handle)} target="_blank" rel="noopener" class="hover:text-clay-700">@{analysis.handle}</a>
          </h1>
          {creator?.displayName && <p class="mt-1 text-ink-500">{creator.displayName}</p>}
          <p class="mt-1 text-xs text-ink-500">
            Tạo lúc {formatDateTime(analysis.createdAt)}
            {analysis.provider === 'mock' && ' · Dữ liệu demo'}
          </p>
        </div>
        {
          done && (
            <a href={`/nguoi-mau-ao/tao?tu-phan-tich=${analysis.id}`} class="btn-primary">
              <Icon name="image" size={17} />
              Tạo ảnh với người mẫu ảo
            </a>
          )
        }
      </div>

      {
        !done && !failed && (
          <div class="card mt-8 p-8 text-center" data-poll={analysis.id}>
            <span class="inline-flex h-10 w-10 animate-spin items-center justify-center rounded-full border-2 border-cream-300 border-t-clay-500" aria-hidden="true" />
            <p class="mt-4 font-medium text-ink-900" data-poll-label>{STATUS_LABEL[analysis.status] ?? analysis.status}</p>
            <p class="mt-1 text-sm text-ink-500">Trang tự cập nhật khi xong. Thường mất 10–60 giây.</p>
          </div>
        )
      }

      {
        failed && (
          <div class="card mt-8 p-6">
            <p class="alert-error">{analysis.error ?? 'Phân tích thất bại.'}</p>
            <a href="/tiktok" class="btn-secondary mt-4">Thử lại với kênh khác</a>
          </div>
        )
      }

      {
        done && metrics && (
          <>
            {/* Tổng quan */}
            <div class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
              {creator && <StatTile label="Follower" value={compactNumber(creator.followers)} />}
              <StatTile label="View trung vị" value={compactNumber(metrics.views.median)} hint={`${metrics.videoCount} video gần nhất`} />
              <StatTile label="Tỉ lệ tương tác" value={percent(metrics.engagementRate)} hint="(like+bl+share+lưu)/view" />
              <StatTile label="Tỉ lệ lưu" value={percent(metrics.saveRate, 2)} hint="lưu / view" />
              <StatTile label="Tỉ lệ chia sẻ" value={percent(metrics.shareRate, 2)} hint="share / view" />
              <StatTile label="Tần suất đăng" value={`${metrics.postsPerWeek.toFixed(1)}/tuần`} hint={metrics.avgDurationS ? `TB ${Math.round(metrics.avgDurationS)} giây/video` : undefined} />
            </div>

            {/* AI tóm tắt + điểm */}
            <div class="mt-8 grid gap-6 lg:grid-cols-[1fr_18rem]">
              <div class="card p-6">
                <p class="eyebrow">AI nhận xét</p>
                {result ? (
                  <>
                    <p class="mt-3 text-[1.0625rem] leading-relaxed text-ink-900">{result.summary}</p>
                    <div class="mt-4 flex flex-wrap items-center gap-2">
                      <span
                        class:list={[
                          'badge',
                          result.trend.direction === 'len' && 'bg-sage-100 text-sage-700',
                          result.trend.direction === 'xuong' && 'bg-red-50 text-red-700',
                          result.trend.direction === 'di_ngang' && 'bg-cream-200 text-ink-700',
                        ]}
                      >
                        {TREND_LABEL[result.trend.direction]}
                      </span>
                      <span class="text-sm text-ink-500">{result.trend.reason}</span>
                    </div>
                  </>
                ) : (
                  <p class="alert-info mt-3">
                    Phần nhận xét của AI chưa có cho lần phân tích này (AI không gọi được). Các chỉ số bên dưới vẫn
                    đầy đủ. Bạn có thể phân tích lại sau.
                  </p>
                )}
              </div>
              <div class="card flex flex-col items-center justify-center p-6 text-center">
                <p class="eyebrow">Điểm sức khoẻ kênh</p>
                {result ? (
                  <>
                    <p class:list={['mt-2 font-serif text-6xl font-semibold tabular-nums', scoreTone(result.healthScore)]}>{result.healthScore}</p>
                    <p class="text-sm text-ink-500">trên 100</p>
                  </>
                ) : (
                  <p class="mt-2 font-serif text-4xl text-cream-400">–</p>
                )}
              </div>
            </div>

            {/* Biểu đồ view */}
            <div class="card mt-6 p-6">
              <h2 class="font-serif text-xl font-semibold">View theo ngày đăng</h2>
              <p class="mt-1 text-sm text-ink-500">
                Từ {fmtDate(metrics.from)} đến {fmtDate(metrics.to)}
              </p>
              <div class="mt-4">
                <ViewsChart series={metrics.series} highlightIds={topIds} />
              </div>
            </div>

            {/* Video nổi bật */}
            <div class="card mt-6 p-6">
              <h2 class="font-serif text-xl font-semibold">Video nổi bật</h2>
              {metrics.topVideos.length === 0 ? (
                <p class="mt-2 text-sm text-ink-500">Chưa có video nào vượt 2 lần trung vị. Kênh đang đều, chưa có cú bứt.</p>
              ) : (
                <ul class="mt-4 divide-y divide-cream-300">
                  {metrics.topVideos.map((v) => (
                    <li class="py-4 first:pt-0 last:pb-0">
                      <div class="flex flex-wrap items-start justify-between gap-3">
                        <a href={v.url} target="_blank" rel="noopener" class="min-w-0 flex-1 font-medium text-ink-900 hover:text-clay-700">
                          {v.caption?.slice(0, 140) || '(không có caption)'}
                        </a>
                        <span class="badge bg-clay-50 text-clay-700">gấp {v.multiple.toFixed(1).replace('.', ',')} lần</span>
                      </div>
                      <p class="mt-1 text-xs text-ink-500 tabular-nums">
                        {fmtDate(v.postedAt)} · {compactNumber(v.views)} view · {compactNumber(v.likes)} like · {compactNumber(v.comments)} bình luận ·{' '}
                        {compactNumber(v.shares)} share · {compactNumber(v.saves)} lưu
                      </p>
                      {whyById.get(v.tiktokId) && <p class="mt-2 text-sm text-ink-700">{whyById.get(v.tiktokId)}</p>}
                    </li>
                  ))}
                </ul>
              )}
            </div>

            {/* Giờ đăng + hashtag */}
            <div class="mt-6 grid gap-6 lg:grid-cols-2">
              <div class="card p-6">
                <h2 class="font-serif text-xl font-semibold">Khi nào nên đăng</h2>
                {bestHours.length > 0 && (
                  <p class="mt-2 text-sm text-ink-700">
                    Khung giờ tốt: <strong>{bestHours.map((s) => `${s.slot}h`).join(', ')}</strong>
                    {bestDays.length > 0 && (
                      <>
                        {' '}· Thứ tốt: <strong>{bestDays.map((s) => WEEKDAY_LABEL[s.slot]).join(', ')}</strong>
                      </>
                    )}
                  </p>
                )}
                <div class="mt-4">
                  <SlotHeatmap byHour={metrics.byHour} byWeekday={metrics.byWeekday} />
                </div>
                {result?.postingAdvice && <p class="mt-4 text-sm text-ink-700">{result.postingAdvice}</p>}
              </div>
              <div class="card p-6">
                <h2 class="font-serif text-xl font-semibold">Hashtag và nhạc</h2>
                <div class="mt-4">
                  <TagBars tags={metrics.hashtags} />
                </div>
                {metrics.music.length > 0 && (
                  <div class="mt-6">
                    <p class="mb-2 text-sm font-medium text-ink-700">Nhạc dùng nhiều</p>
                    <TagBars tags={metrics.music.slice(0, 5)} prefix="" />
                  </div>
                )}
                {result?.hashtagAdvice && <p class="mt-4 text-sm text-ink-700">{result.hashtagAdvice}</p>}
              </div>
            </div>

            {/* Chủ đề + ý tưởng + checklist */}
            {result && (
              <div class="mt-6 grid gap-6 lg:grid-cols-2">
                <div class="card p-6">
                  <h2 class="font-serif text-xl font-semibold">Nhóm nội dung</h2>
                  <ul class="mt-4 space-y-3">
                    {result.themes.map((t) => (
                      <li class="rule pt-3 first:border-0 first:pt-0">
                        <p class="font-medium text-ink-900">{t.name}</p>
                        <p class="text-sm text-ink-500">
                          {t.share}
                          {t.performance && ` · ${t.performance}`}
                        </p>
                      </li>
                    ))}
                  </ul>
                </div>
                <div class="card p-6">
                  <h2 class="font-serif text-xl font-semibold">Ý tưởng video tiếp theo</h2>
                  <ol class="mt-4 space-y-3">
                    {result.nextIdeas.map((n, i) => (
                      <li class="flex gap-3">
                        <span class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-clay-50 text-xs font-semibold text-clay-700">{i + 1}</span>
                        <div>
                          <p class="font-medium text-ink-900">“{n.hook}”</p>
                          {n.idea && <p class="text-sm text-ink-500">{n.idea}</p>}
                        </div>
                      </li>
                    ))}
                  </ol>
                </div>
                {result.checklist.length > 0 && (
                  <div class="card p-6 lg:col-span-2">
                    <h2 class="font-serif text-xl font-semibold">Việc cần làm trong 2 tuần tới</h2>
                    <ul class="mt-4 grid gap-2 sm:grid-cols-2">
                      {result.checklist.map((item) => (
                        <li class="flex gap-2 text-sm text-ink-700">
                          <span class="mt-0.5 text-sage-500">
                            <Icon name="check" size={16} weight={2} />
                          </span>
                          {item}
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>
            )}

            {/* Bảng video */}
            <div class="card mt-6 overflow-hidden p-0">
              <div class="p-6 pb-3">
                <h2 class="font-serif text-xl font-semibold">Tất cả video đã kéo</h2>
                <p class="mt-1 text-sm text-ink-500">{videos.length} video, mới nhất xếp trước.</p>
              </div>
              <div class="overflow-x-auto">
                <table class="w-full text-sm">
                  <thead class="bg-cream-100 text-left text-xs text-ink-500 uppercase">
                    <tr>
                      <th class="px-4 py-2 font-medium">Ngày</th>
                      <th class="px-4 py-2 font-medium">Caption</th>
                      <th class="px-4 py-2 text-right font-medium">View</th>
                      <th class="px-4 py-2 text-right font-medium">Like</th>
                      <th class="px-4 py-2 text-right font-medium">BL</th>
                      <th class="px-4 py-2 text-right font-medium">Share</th>
                      <th class="px-4 py-2 text-right font-medium">Lưu</th>
                      <th class="px-4 py-2 text-right font-medium">Giây</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-cream-300">
                    {videos.map((v) => (
                      <tr class:list={[topIds.includes(v.tiktokId) && 'bg-clay-50/60']}>
                        <td class="px-4 py-2 whitespace-nowrap text-ink-500 tabular-nums">{fmtDate(v.postedAt)}</td>
                        <td class="max-w-[22rem] px-4 py-2">
                          <a href={v.url} target="_blank" rel="noopener" class="line-clamp-2 text-ink-900 hover:text-clay-700">
                            {v.caption || '(không có caption)'}
                          </a>
                        </td>
                        <td class="px-4 py-2 text-right tabular-nums">{compactNumber(v.views)}</td>
                        <td class="px-4 py-2 text-right tabular-nums">{compactNumber(v.likes)}</td>
                        <td class="px-4 py-2 text-right tabular-nums">{compactNumber(v.comments)}</td>
                        <td class="px-4 py-2 text-right tabular-nums">{compactNumber(v.shares)}</td>
                        <td class="px-4 py-2 text-right tabular-nums">{compactNumber(v.saves)}</td>
                        <td class="px-4 py-2 text-right text-ink-500 tabular-nums">{v.durationS ?? '–'}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          </>
        )
      }
    </div>
  </section>
</SiteLayout>

<script>
  // Khi chưa xong: hỏi trạng thái mỗi 3 giây, cập nhật nhãn, xong thì tải lại trang.
  const box = document.querySelector<HTMLElement>('[data-poll]');
  if (box) {
    const id = box.dataset.poll;
    const label = box.querySelector<HTMLElement>('[data-poll-label]');
    const tick = async () => {
      try {
        const response = await fetch(`/api/tiktok/analyses/${id}/status`, { cache: 'no-store' });
        const data = (await response.json()) as { status: string; label: string };
        if (label) label.textContent = data.label;
        if (data.status === 'done' || data.status === 'failed') {
          window.location.reload();
          return;
        }
      } catch {
        // mạng chập chờn thì lần sau thử lại
      }
      setTimeout(tick, 3000);
    };
    setTimeout(tick, 3000);
  }
</script>
